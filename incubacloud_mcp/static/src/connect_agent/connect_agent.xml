<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="incubacloud_mcp.CopyBlock">
        <div t-att-class="props.inline ? 'ic-mcp-copy ic-mcp-copy--inline' : 'ic-mcp-copy'">
            <code t-if="props.inline" class="ic-mcp-url" t-esc="props.text"/>
            <pre t-else="" class="ic-mcp-code" t-esc="props.text"/>
            <button class="rl-btn rl-btn-ghost rl-btn-sm" type="button"
                    t-att-aria-label="props.label" t-on-click="copy">Copy</button>
            <span class="ic-mcp-copied" role="status"><t t-if="state.copied">Copied</t></span>
        </div>
    </t>

    <t t-name="incubacloud_mcp.ConnectAgent">
        <div class="rl-page ic-mcp-connect">

            <div class="rl-phead">
                <div class="rl-htext">
                    <h1 class="rl-ptitle">Connect an agent</h1>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="ic-detail-loading">Loading…</div>
            </t>
            <t t-elif="!state.config">
                <p class="ic-mcp-intro">This page could not be loaded. Reload it to try again.</p>
            </t>
            <t t-else="">
                <p class="ic-mcp-intro">
                    AI agents such as Claude Code, Claude, Cursor, VS Code or Codex can work
                    on this panel for you, with your role and your projects' access.
                    Destructive actions wait for your approval, and secrets never reach them.
                </p>

                <div class="rl-saas-fsec">This panel's MCP address</div>
                <CopyBlock t-if="!view.urlProblem" text="view.url" inline="true"
                           label.translate="Copy this panel's MCP address"/>

                <t t-if="view.urlProblem === 'missing'">
                    <div class="ic-mcp-notice">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                        This panel's MCP address is not configured yet, so no agent can
                        connect. A manager sets it in Settings, on the Agents tab.
                    </div>
                </t>
                <t t-elif="view.urlProblem">
                    <div class="ic-mcp-notice">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                        This panel's MCP address is not a plain web address, so no command
                        is shown for it. A manager can correct it in Settings, on the
                        Agents tab.
                    </div>
                </t>
                <t t-elif="view.apiKeysRefused">
                    <div class="ic-mcp-notice">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                        Agents cannot connect to this panel yet: its sign-in for agents is
                        not configured. Contact support.
                    </div>
                </t>
                <t t-elif="view.needsApiKey">
                    <div class="ic-mcp-notice">
                        <i class="fa fa-key" aria-hidden="true"/>
                        This panel accepts API keys only. Create one in your
                        <a t-att-href="view.preferencesUrl" target="_blank" rel="noopener">preferences</a>
                        (Security, API Keys) and put it where the commands say
                        <code t-esc="apiKeyPlaceholder"/>, or in the environment variable
                        they name. Treat it like a password.
                    </div>
                </t>
                <p t-if="view.agentsUrl" class="ic-mcp-intro">
                    See and revoke the agents you connected in
                    <a class="rl-link" t-att-href="view.agentsUrl" target="_blank" rel="noopener">Connected agents</a>.
                </p>

                <t t-if="!view.apiKeysRefused and !view.urlProblem">
                    <div class="rl-tabs" role="tablist" aria-label="Clients">
                        <button t-att-class="state.tab === 'claude_code' ? 'rl-tab active' : 'rl-tab'"
                                type="button" role="tab"
                                t-att-aria-selected="state.tab === 'claude_code' ? 'true' : 'false'"
                                t-on-click="() => this.setTab('claude_code')">Claude Code</button>
                        <button t-att-class="state.tab === 'claude_ai' ? 'rl-tab active' : 'rl-tab'"
                                type="button" role="tab"
                                t-att-aria-selected="state.tab === 'claude_ai' ? 'true' : 'false'"
                                t-on-click="() => this.setTab('claude_ai')">Claude and Claude Desktop</button>
                        <button t-att-class="state.tab === 'cursor_vscode' ? 'rl-tab active' : 'rl-tab'"
                                type="button" role="tab"
                                t-att-aria-selected="state.tab === 'cursor_vscode' ? 'true' : 'false'"
                                t-on-click="() => this.setTab('cursor_vscode')">Cursor and VS Code</button>
                        <button t-att-class="state.tab === 'codex' ? 'rl-tab active' : 'rl-tab'"
                                type="button" role="tab"
                                t-att-aria-selected="state.tab === 'codex' ? 'true' : 'false'"
                                t-on-click="() => this.setTab('codex')">Codex and others</button>
                    </div>

                    <t t-if="state.tab === 'claude_code'">
                        <p class="ic-mcp-step">Run this in a terminal:</p>
                        <CopyBlock text="view.claudeCode" label.translate="Copy the Claude Code command"/>
                        <p t-if="!view.needsApiKey" class="ic-mcp-step">
                            Then run <code t-translation="off">/mcp</code> in Claude Code to sign in.
                        </p>
                    </t>

                    <t t-if="state.tab === 'claude_ai'">
                        <ol class="ic-mcp-steps">
                            <li>In Claude, open Customize, then Connectors, and choose + Add, then Add custom connector.</li>
                            <li>Name it, for example IncubaCloud, and paste this panel's MCP address.</li>
                            <li t-if="view.needsApiKey">
                                Choose No sign in. Under Request headers, add the header
                                <code t-translation="off">Authorization</code> with the value
                                <code t-translation="off">Bearer <t t-esc="apiKeyPlaceholder"/></code>,
                                then choose Add.
                            </li>
                            <li t-else="">
                                Keep the sign-in settings Claude detects, choose Add, and sign in
                                with your IncubaCloud account.
                            </li>
                        </ol>
                        <p t-if="view.needsApiKey" class="ic-mcp-step">
                            Only on an individual plan: a connector an owner adds in Organization
                            settings is shared by every member, and so would your key be.
                        </p>
                        <p t-else="" class="ic-mcp-step">
                            On a Team or Enterprise plan, an owner adds it once in Organization
                            settings, Connectors (Add, Custom, Web); then each member finds it in
                            Customize, Connectors, and chooses Connect.
                        </p>
                        <p class="ic-mcp-step">
                            Claude connects from Anthropic's servers, not from your computer: this
                            panel must be reachable from the internet.
                        </p>
                    </t>

                    <t t-if="state.tab === 'cursor_vscode'">
                        <div class="rl-saas-fsec">Cursor</div>
                        <t t-if="view.cursorLink">
                            <p class="ic-mcp-step">
                                <a class="rl-btn rl-btn-primary" t-att-href="view.cursorLink">Add to Cursor</a>
                            </p>
                        </t>
                        <t t-else="">
                            <p class="ic-mcp-step">Add this to ~/.cursor/mcp.json:</p>
                            <CopyBlock text="view.cursorJson" label.translate="Copy Cursor's configuration"/>
                            <p class="ic-mcp-step">
                                Cursor reads the key from the environment variable
                                <code t-esc="apiKeyEnv"/>: set it before you start Cursor.
                            </p>
                        </t>
                        <div class="rl-saas-fsec">VS Code</div>
                        <p class="ic-mcp-step">Run this in a terminal:</p>
                        <CopyBlock text="view.vscode" label.translate="Copy the VS Code command"/>
                    </t>

                    <t t-if="state.tab === 'codex'">
                        <div class="rl-saas-fsec">Codex</div>
                        <p class="ic-mcp-step">Add this to ~/.codex/config.toml:</p>
                        <CopyBlock text="view.codex" label.translate="Copy Codex's configuration"/>
                        <t t-if="view.codexLogin">
                            <p class="ic-mcp-step">Then run this to sign in:</p>
                            <CopyBlock text="view.codexLogin" label.translate="Copy Codex's sign-in command"/>
                        </t>
                        <p t-if="view.needsApiKey" class="ic-mcp-step">
                            Codex reads the key from the environment variable
                            <code t-esc="apiKeyEnv"/>: set it before you start Codex.
                        </p>
                        <div class="rl-saas-fsec">Other clients</div>
                        <p class="ic-mcp-step">
                            Add a remote MCP server of type HTTP with this panel's MCP address.
                            <t t-if="view.needsApiKey">
                                Send your API key in the header
                                <code t-translation="off">Authorization: Bearer <t t-esc="apiKeyPlaceholder"/></code>.
                            </t>
                        </p>
                    </t>
                </t>

                <p t-if="view.docsUrl" class="ic-mcp-docs">
                    <a class="rl-link" t-att-href="view.docsUrl" target="_blank" rel="noopener">How agents work with the panel</a>
                </p>
            </t>
        </div>
    </t>

</templates>
