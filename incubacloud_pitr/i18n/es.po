msgstr "Desactivar recuperación continua"

#. module: incubacloud_pitr
#: model:cloud.job.type,name:incubacloud_pitr.pitr_enable
msgid "Switch Continuous Recovery On"
msgstr "Activar recuperación continua"

#. module: incubacloud_pitr
#. odoo-python
#: code:addons/incubacloud_pitr/__init__.py:0
msgid ""
"Switch continuous recovery off on %s instance(s) before uninstalling this "
"module."
msgstr ""
"Desactive la recuperación continua en %s instancia(s) antes de desinstalar "
"este módulo."

#. module: incubacloud_pitr
#. odoo-javascript
#: code:addons/incubacloud_pitr/static/src/components/pitr_panel/pitr_panel.xml:0
msgid "Switch off"
msgstr "Desactivar"

#. module: incubacloud_pitr
#. odoo-javascript
#: code:addons/incubacloud_pitr/static/src/components/pitr_panel/pitr_panel.xml:0
msgid "Switch on"
msgstr "Activar"

#. module: incubacloud_pitr
#. odoo-javascript
#: code:addons/incubacloud_pitr/static/src/components/pitr_panel/pitr_panel.js:0
msgid "Switching off…"
msgstr "Desactivándose…"

#. module: incubacloud_pitr
#: model:ir.model.fields.selection,name:incubacloud_pitr.selection__cloud_instance__pitr_state__enabling
msgid "Switching on"
