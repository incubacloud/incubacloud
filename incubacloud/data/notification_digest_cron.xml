<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: an update would move nextcall to the next day's
         07:00, and one before 07:00 would skip that day's digest. A
         change to this record reaches existing databases by a
         migration. -->
    <data noupdate="1">
        <record id="cron_cloud_notification_digest" model="ir.cron">
            <field name="name">Send daily cloud notification digest</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_cloud_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        </record>
    </data>
</odoo>
