<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_purge_audit_logs" model="ir.cron">
        <field name="name">Purge Old Audit Logs</field>
        <field name="model_id" ref="model_cloud_audit_log"/>
        <!-- Runs as OdooBot: purges via sudo() and the manager group has no
             write on cloud.audit.log (Odoo 18 pre-checks write here). -->
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">
ICP = env['ir.config_parameter'].sudo()
days = int(ICP.get_param('incubacloud.audit_log_retention_days', '90') or 90)
model._purge_old(days)
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="cron_purge_job_log_chunks" model="ir.cron">
        <field name="name">Purge Old Job Log Chunks</field>
        <field name="model_id" ref="model_cloud_job_log_chunk"/>
        <field name="state">code</field>
        <field name="code">
settings = env['cloud.settings'].sudo()._get()
days = settings.job_log_retention_days or 0
model._purge_old(days)
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
