<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Every 5 minutes, the sign-ins, sudo commands and changes to
             watched files the servers sent to the central's Loki
             (models/cloud_security_events.py). Nothing without a central
             or a server sending its security logs. -->
        <record id="cron_security_events" model="ir.cron">
            <field name="name">Read the servers' security events</field>
            <field name="model_id" ref="model_cloud_security_events"/>
            <field name="state">code</field>
            <field name="code">model._cron_security_events()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

    </data>
</odoo>
