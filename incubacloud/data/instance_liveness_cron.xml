<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Derives cloud.instance.running from cAdvisor. Runs alongside the
         SSH telemetry on purpose: the old source is not retired until this
         one has been verified against real data. -->
    <record id="cron_instance_liveness_from_metrics" model="ir.cron">
        <field name="name">Refresh instance liveness from metrics</field>
        <field name="model_id" ref="model_cloud_instance"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_running_from_metrics()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Replaces host_metrics_executor's SSH job: node_exporter already
         reports cores, RAM and disk. -->
    <record id="cron_host_specs_from_metrics" model="ir.cron">
        <field name="name">Refresh host specs from metrics</field>
        <field name="model_id" ref="model_cloud_host"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_specs_from_metrics()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
