<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_cloud_terminal_route_gc" model="ir.cron">
        <field name="name">Garbage-collect stale terminal routes</field>
        <field name="model_id" ref="model_cloud_terminal_route"/>
        <field name="state">code</field>
        <field name="code">model._gc()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <!-- The host shell's routes carry an encrypted bearer token for a
         login shell on the whole machine. Without a sweep they were only
         collected lazily, on a later _resolve() of that same session, so
         a session whose subprocess died uncleanly lingered forever. -->
    <record id="cron_cloud_host_terminal_route_gc" model="ir.cron">
        <field name="name">Garbage-collect stale host terminal routes</field>
        <field name="model_id" ref="model_cloud_host_terminal_route"/>
        <field name="state">code</field>
        <field name="code">model._gc()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
