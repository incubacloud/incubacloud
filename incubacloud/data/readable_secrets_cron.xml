<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Also triggered once at startup (cloud.settings._register_hook):
             the right key usually arrives with a restart. -->
        <record id="cron_resolve_readable_secrets" model="ir.cron">
            <field name="name">Close alerts on secrets that read again</field>
            <field name="model_id" ref="model_cloud_settings"/>
            <field name="state">code</field>
            <field name="code">model._cron_resolve_readable_secrets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
