<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_cloud_rate_limit_gc" model="ir.cron">
        <field name="name">Garbage-collect expired rate-limit buckets</field>
        <field name="model_id" ref="model_cloud_rate_limit"/>
        <!-- Runs as OdooBot: GCs via sudo() and the manager group has no
             write on cloud.rate.limit (Odoo 18 pre-checks write here). -->
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._gc()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
