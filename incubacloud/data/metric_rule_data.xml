<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Seed rules for observability v1.

        NOT ``noupdate``: these are tuning knobs, not user data. Shipping
        them updatable means a better threshold reaches existing installs
        on upgrade instead of only new ones — the trap that made a
        sleep timeout stale in production.

        Every expression carries ``host_id`` because that is how a sample
        is mapped back to a cloud.host (see cloud_metric_rule.host_label).
    -->

    <record id="metric_rule_host_down" model="cloud.metric.rule">
        <field name="name">Host stopped reporting</field>
        <field name="sequence">1</field>
        <field name="code">metrics_host_absent</field>
        <!-- Measures over its own window: one sample is already a verdict. -->
        <field name="confirm_cycles">1</field>
        <!-- Age, per host, of the last sample that arrived.
             Two earlier attempts were wrong, both verified against a
             live VictoriaMetrics rather than by reading:

             ``absent(up{job="node"})`` returns a series carrying only
             the equality matchers of its selector, so it has no
             ``host_id`` and the evaluator drops the sample — nothing
             could ever be raised. It also only turns 1 when EVERY host
             is silent, the opposite of a per-host watchdog.

             ``timestamp(last_over_time(up[1h]))`` returns an EMPTY
             result in VictoriaMetrics v1.102 even with a live host, so
             it would never have fired either.

             The subquery below is what actually works: it samples
             ``timestamp(up)`` every minute for an hour and keeps the
             last one that existed, which survives the series going
             stale. Measured on a host silenced for six minutes: the
             plain form returned nothing, this returned 341 s with
             ``host_id`` and ``host`` intact. -->
        <field name="expression">time() - max by (host_id, host) (last_over_time(timestamp(up{job="node"})[1h:1m]))</field>
        <field name="comparator">gt</field>
        <!-- ~10 missed pushes at the 30 s scrape interval. -->
        <field name="threshold">300</field>
        <field name="level">critical</field>
        <field name="message">Host %(host)s has stopped reporting metrics.</field>
    </record>

    <record id="metric_rule_disk_critical" model="cloud.metric.rule">
        <field name="name">Disk almost full</field>
        <field name="sequence">10</field>
        <field name="code">metrics_disk_critical</field>
        <!-- An instant reading: a lone spike must not page anyone. -->
        <field name="confirm_cycles">2</field>
        <field name="expression">100 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} * 100)</field>
        <field name="comparator">gt</field>
        <field name="threshold">90</field>
        <field name="level">critical</field>
        <field name="message">Disk on %(host)s is %(value)s%% full.</field>
    </record>

    <record id="metric_rule_memory_high" model="cloud.metric.rule">
        <field name="name">Memory nearly exhausted</field>
        <field name="sequence">20</field>
        <field name="code">metrics_memory_high</field>
        <!-- An instant reading: a lone spike must not page anyone. -->
        <field name="confirm_cycles">2</field>
        <field name="expression">100 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100)</field>
        <field name="comparator">gt</field>
        <field name="threshold">92</field>
        <field name="level">warning</field>
        <field name="message">Memory on %(host)s is %(value)s%% used.</field>
    </record>

    <record id="metric_rule_load_high" model="cloud.metric.rule">
        <field name="name">Sustained CPU saturation</field>
        <field name="sequence">30</field>
        <field name="code">metrics_cpu_saturated</field>
        <!-- An instant reading: a lone spike must not page anyone. -->
        <field name="confirm_cycles">2</field>
        <!-- Load per core over 15 min: survives a burst, catches a stuck host. -->
        <field name="expression">node_load15 / count without (cpu, mode) (node_cpu_seconds_total{mode="idle"})</field>
        <field name="comparator">gt</field>
        <field name="threshold">2</field>
        <field name="level">warning</field>
        <field name="message">CPU on %(host)s has been saturated (load/core %(value)s).</field>
    </record>

    <record id="metric_rule_proxy_down" model="cloud.metric.rule">
        <field name="name">Host proxy not running</field>
        <field name="sequence">35</field>
        <field name="code">metrics_proxy_absent</field>
        <!-- An instant reading: a proxy recreated by a deploy is gone for
             seconds, and must not page anyone. -->
        <field name="confirm_cycles">2</field>
        <!-- A host that still reports, minus the hosts whose proxy
             container does: what is left is a host with no proxy, and
             with it no instance answering. The container's samples go
             stale minutes after it stops or is removed, which is when
             its host appears here. On 2 November 2026 a host ran nine
             hours without its proxy and nothing said so: every check
             reached the host over SSH, never through the proxy.
             Verified on the live backend: with every proxy up this is
             empty; asked for a container no host runs, it names every
             host, with ``host_id`` and ``host``. -->
        <field name="expression">(max by (host_id, host) (up{job="node"})) unless on (host_id) (max by (host_id) (container_last_seen{name="inverseproxy-proxy-1"}))</field>
        <field name="comparator">gt</field>
        <field name="threshold">0</field>
        <field name="level">critical</field>
        <field name="message">The proxy on %(host)s is not running: no instance on it answers.</field>
    </record>

    <!-- Waits measured by the kernel (PSI, node_exporter's pressure
         collector): the share of the time tasks of the whole server
         stalled for the disk or for memory. A load or a percentage
         says how busy a server is; these say that it is too busy for
         its instances, which is what makes them slow. Added
         12-nov-2026 with the server's Metrics tab (plan of observability,
         section 2.6), thresholds to tune in QA with real data. -->
    <record id="metric_rule_host_io_pressure" model="cloud.metric.rule">
        <field name="name">Disk saturated</field>
        <field name="sequence">32</field>
        <field name="code">metrics_host_io_pressure</field>
        <!-- Three evaluations, fifteen minutes: a backup or a rebuild
             saturates a disk for a few minutes and is not a fault. -->
        <field name="confirm_cycles">3</field>
        <!-- "some": at least one task waited for the disk. -->
        <field name="expression">round(100 * max by (host_id, host) (rate(node_pressure_io_waiting_seconds_total[5m])))</field>
        <field name="comparator">gt</field>
        <!-- A fifth of the time: every instance of the server feels it
             (the same threshold as the boards' diagnosis). -->
        <field name="threshold">20</field>
        <field name="level">warning</field>
        <field name="message">The disk of %(host)s has been saturated for 15 minutes: tasks waited for it %(value)s%% of the time, so every instance on it is slow. If a backup or a migration is running, wait for it to end; otherwise the server needs a faster disk.</field>
    </record>

    <record id="metric_rule_host_memory_pressure" model="cloud.metric.rule">
        <field name="name">Server out of memory</field>
        <field name="sequence">33</field>
        <field name="code">metrics_host_memory_pressure</field>
        <!-- An instant reading over five minutes: a lone spike must not
             page anyone. -->
        <field name="confirm_cycles">2</field>
        <!-- "full": every task that was not idle stalled for memory at
             once, the kernel reclaiming pages instead of running them. -->
        <field name="expression">round(100 * max by (host_id, host) (rate(node_pressure_memory_stalled_seconds_total[5m])))</field>
        <field name="comparator">gt</field>
        <!-- A tenth of the time with nothing running for lack of memory:
             the server is evicting the pages of every instance. -->
        <field name="threshold">10</field>
        <field name="level">critical</field>
        <field name="message">%(host)s has run out of memory: its tasks all stalled waiting for it %(value)s%% of the time, so every instance on it slows down. Move an instance to another server or give this one more memory.</field>
    </record>

    <!-- ── Instance-scoped rules ──────────────────────────────────────
         These raise against the instance, so the alert lands on its own
         page instead of being buried in its host's. All depend on the
         agents' relabelling attaching ``instance_id``.

         Note what is deliberately NOT here: a disk-usage rule per
         instance. The textfile collector reports bytes used, not a
         percentage, and a byte threshold means nothing across instances
         of different sizes — it would either never fire or fire on the
         big ones permanently. Disk stays a host-level rule until there
         is a per-instance quota to compare against.
    -->

    <record id="metric_rule_instance_down" model="cloud.metric.rule">
        <field name="name">Instance stopped reporting</field>
        <field name="sequence">40</field>
        <field name="code">metrics_instance_absent</field>
        <!-- An instant reading: a lone spike must not page anyone. -->
        <field name="confirm_cycles">2</field>
        <field name="scope">instance</field>
        <!-- Age of the newest container sample for this instance. Same
             shape as the host watchdog, and for the same reason: a
             plain absent() carries no instance label, so nothing could
             be attributed and no alert could ever be raised. -->
        <field name="expression">max by (instance_id, instance) (time() - container_last_seen{instance_id!=""})</field>
        <field name="comparator">gt</field>
        <!-- Generous on purpose. A rebuild stops containers for a while,
             and a deploy that takes four minutes must not page anyone. -->
        <field name="threshold">300</field>
        <field name="level">critical</field>
        <field name="message">Instance %(host)s has stopped reporting containers.</field>
    </record>

    <record id="metric_rule_instance_errors" model="cloud.metric.rule">
        <field name="name">Instance returning server errors</field>
        <field name="sequence">50</field>
        <field name="code">metrics_instance_5xx</field>
        <!-- Measures over its own window: one sample is already a verdict. -->
        <field name="confirm_cycles">1</field>
        <field name="scope">instance</field>
        <!-- Server errors per second over five minutes, attributed by
             the Traefik relabelling. This is the signal that says "the
             instance is up and failing", which no container metric can
             express — an Odoo throwing 500s looks perfectly healthy to
             cAdvisor. -->
        <field name="expression">sum by (instance_id, instance) (rate(traefik_service_requests_total{code=~"5..",instance_id!=""}[5m]))</field>
        <field name="comparator">gt</field>
        <!-- Roughly one server error every two seconds, sustained. Low
             enough to catch a broken deploy, high enough that the odd
             500 from a crawler hitting a bad URL does not page. -->
        <field name="threshold">0.5</field>
        <field name="level">warning</field>
        <field name="message">Instance %(host)s is returning %(value)s server errors per second.</field>
    </record>

    <record id="metric_rule_instance_oom" model="cloud.metric.rule">
        <field name="name">Instance container out of memory</field>
        <field name="sequence">60</field>
        <field name="code">metrics_instance_oom</field>
        <!-- Measures over its own window: one sample is already a verdict. -->
        <field name="confirm_cycles">1</field>
        <field name="scope">instance</field>
        <!-- Processes the kernel killed for lack of memory in the odoo,
             db or smtp container, over fifteen minutes (three ticks of
             the cron, so none falls between two evaluations). A kill is
             the fact that matters, and nothing reported one: on
             5-Nov-2026 a panel's smtp counted 36 in a month with no
             alert. The memory percentage cannot stand in for it: a
             database's usage is mostly cache and always reads 90-95 %.
             See docs/architecture.md, "Memory an instance is deployed
             with".

             increase_prometheus, not increase (review of 5-Nov-2026):
             VictoriaMetrics' increase takes a series that appears inside
             the window as starting from 0, so a series that appears, or
             comes back after a gap in its samples, with a counter that
             already reads 1 to 5 counted that many kills just now;
             checked against v1.102.0, the central's version, on
             5-Nov-2026. increase_prometheus reads only the samples
             inside the window: it still sees a kill after a counter
             reset, and misses only one before a series' first two
             samples. -->
        <field name="expression">sum by (instance_id, instance) (increase_prometheus(container_oom_events_total{instance_id!="", container_label_com_docker_compose_service=~"odoo|db|smtp"}[15m]))</field>
        <field name="comparator">gt</field>
        <field name="threshold">0</field>
        <field name="level">critical</field>
        <field name="message">Instance %(host)s ran out of memory: the kernel killed %(value)s process(es) of its odoo, db or smtp container in the last 15 minutes.</field>
    </record>

    <record id="metric_rule_instance_cpu_throttled" model="cloud.metric.rule">
        <field name="name">Instance held back by its CPU quota</field>
        <field name="sequence">70</field>
        <field name="code">metrics_instance_cpu_throttled</field>
        <!-- Three evaluations, fifteen minutes: an import or a report
             takes the quota for a while, and that is what it is for. -->
        <field name="confirm_cycles">3</field>
        <field name="scope">instance</field>
        <!-- Share of the scheduler's periods in which the odoo container
             wanted CPU and its quota (cpus) said no, its one-off runs
             left out. Added 12-nov-2026 (plan of observability, section
             2.6); the instance board's diagnosis reads the same share. -->
        <field name="expression">round(100 * sum by (instance_id, instance) (rate(container_cpu_cfs_throttled_periods_total{instance_id!="", container_label_com_docker_compose_service="odoo", name!~".+-run-[0-9a-f]{12}|ic_boot_odoo_[0-9]+"}[5m])) / sum by (instance_id, instance) (rate(container_cpu_cfs_periods_total{instance_id!="", container_label_com_docker_compose_service="odoo", name!~".+-run-[0-9a-f]{12}|ic_boot_odoo_[0-9]+"}[5m])))</field>
        <field name="comparator">gt</field>
        <!-- A quarter of the time: requests queue behind the quota most
             of the time (the instance board's threshold, 10-nov-2026). -->
        <field name="threshold">25</field>
        <field name="level">warning</field>
        <field name="message">Instance %(host)s has been held back by its CPU quota for 15 minutes (%(value)s%% of the time): its requests wait. Raise the quota in Resources or spread the instances over more servers.</field>
    </record>

    <record id="cron_cloud_metric_rule_evaluate" model="ir.cron">
        <field name="name">Evaluate metric rules</field>
        <field name="model_id" ref="model_cloud_metric_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_evaluate()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
