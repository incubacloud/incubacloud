<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inactive by default — turning it on is a deliberate operator
        action during a MultiFernet rotation (new primary key prepended
        to INCUBACLOUD_SECRET_KEY, old key still trailing). Running it
        otherwise is a no-op but wastes a transaction per interval.
    -->
    <record id="cron_rotate_encrypted_secrets" model="ir.cron">
        <field name="name">Rotate Encrypted Secrets (MultiFernet)</field>
        <field name="model_id" ref="model_cloud_settings"/>
        <field name="state">code</field>
        <field name="code">model._rotate_all_secrets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
