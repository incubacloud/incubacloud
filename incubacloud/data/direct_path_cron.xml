<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Keeps every direct port's list applied and its names probed
        (plan-trafico-interno-directo, piece 2).

        The events queue the job the moment a host comes or goes; this
        cron is the net under them. Every 15 minutes it queues the job
        only where the list in force differs from the one it should be,
        or the last good run is over an hour old: that run puts back what
        a reboot or an old re-hardening took from nftables, and probes
        the names again (DNS, AAAA, certificate). A list behind for over
        30 minutes raises direct_allowlist_stale.
    -->
    <record id="cron_sync_direct_path" model="ir.cron">
        <field name="name">Sync the direct path's list</field>
        <field name="model_id" ref="model_cloud_host"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_direct_path()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
