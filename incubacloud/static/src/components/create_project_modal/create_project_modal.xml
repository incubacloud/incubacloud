<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

   <t t-name="incubacloud.CreateProjectModal">
        <div class="ic-modal-overlay" t-on-click="onOverlayClick">
            <div class="ic-modal ic-modal--m"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="ic-create-project-title"
                 t-ref="box"
                 t-on-click.stop="">

            <!-- Header -->
            <header class="ic-modal__header">
                <h3 id="ic-create-project-title">Create project</h3>
                <button class="ic-modal__close" aria-label="Close" t-on-click="close">
                    <t t-out="env.icon('x', 16)"/>
                </button>
            </header>

            <!-- Body -->
            <section class="ic-modal__body">
                <div class="ic-frow">
                    <label>Name <span class="ic-req">*</span></label>
                    <input
                        type="text"
                        t-model="state.name"
                        placeholder="customer-x"
                    />
                    <small class="ic-fhint">Logical grouping for instances</small>
                </div>

                <div class="ic-frow">
                    <label>Description</label>
                    <textarea
                        rows="3"
                        t-model="state.description"
                        placeholder="Optional description"
                    />
                </div>

                <div class="ic-frow">
                    <label>Tags</label>
                    <TagSelector
                        selected="state.selectedTags"
                        available="state.allTags"
                        onAdd.bind="addTag"
                        onRemove.bind="removeTag"
                        onCreate.bind="createTag"
                    />
                </div>

                <t t-if="state.error">
                    <div class="ic-alert ic-alert--error" role="alert">
                        <span class="ic-alert__icon"><t t-out="env.icon('alert', 15)"/></span>
                        <span class="ic-alert__text"><t t-esc="state.error"/></span>
                    </div>
                </t>
            </section>

            <!-- Footer -->
            <footer class="ic-modal__footer">
                <button class="ic-btn ic-btn--ghost" t-on-click="close">
                    Cancel
                </button>
                <button
                    class="ic-btn ic-btn--primary"
                    t-on-click="create"
                    t-att-disabled="!isValid || state.loading">
                    <t t-if="state.loading">Creating…</t>
                    <t t-else="">Create project</t>
                </button>
            </footer>

            </div>
        </div>
    </t>

</templates>
