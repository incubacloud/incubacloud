<templates>

    <t t-name="incubacloud.HostsDashboard">
        <div class="rl-page ic-hosts-dashboard">

            <!-- Header -->
            <div class="rl-phead">
                <div class="rl-htext">
                    <h1 class="rl-ptitle">Hosts</h1>
                    <p class="rl-psub">
                        <t t-esc="state.total"/> host<t t-if="state.total !== 1">s</t>
                    </p>
                </div>
                <div class="rl-pactions">
                    <button class="rl-btn rl-btn-primary" t-on-click="onAddHost">
                        <t t-out="env.icon('plus', 15)"/> Add Host
                    </button>
                </div>
            </div>


            <TruncationBanner truncated="state.truncated"
                              total="state.total"
                              limit="state.limit"
                              label="'hosts'"/>

            <!-- Empty state -->
            <t t-if="state.visible_hosts.length === 0">
                <div class="rl-stub">
                    <span class="rl-si"><t t-out="env.icon('hosts', 46)"/></span>
                    <h3>No hosts configured</h3>
                    <p>Add a server to start deploying Odoo instances.</p>
                </div>
            </t>

            <!-- Grid of host cards -->
            <t t-else="">
                <div class="rl-grid rl-grid-2 ic-hosts-grid">
                    <t t-foreach="state.visible_hosts" t-as="host" t-key="host.id">
                        <div class="rl-card rl-card-pad ic-host-card click"
                             t-att-class="'status-' + host.status"
                             t-on-click="() => this.onViewHost(host)">

                            <!-- Header: name + status badge -->
                            <div class="ic-host-card-head">
                                <span class="rl-rname" t-esc="host.name"/>
                                <span class="rl-rspacer"/>
                                <span t-att-class="'rl-sb ' + host.status">
                                    <span class="rl-d"/><t t-esc="statusLabel(host.status)"/>
                                </span>
                            </div>

                            <!-- Meta: ip · cores · ram · region -->
                            <div class="rl-rmeta ic-host-card-meta">
                                <t t-if="host.ip_address"><code t-esc="host.ip_address"/></t>
                                <t t-if="hasMetrics(host)">
                                    <t t-if="host.ip_address"> · </t><t t-esc="host.cpu_cores"/> cores
                                    · <t t-esc="formatRam(host.ram_total_gb)"/> RAM
                                </t>
                                <t t-if="host.region"> · <t t-esc="host.region"/></t>
                            </div>

                            <!-- Tags -->
                            <t t-if="host.tags and host.tags.length">
                                <div class="rl-tag-list">
                                    <t t-foreach="host.tags" t-as="tag" t-key="tag.id">
                                        <span class="rl-tag-badge" t-att-style="tagBadgeStyle(tag)">
                                            <span class="ic-tag-dot" t-att-style="tagDotStyle(tag)"/>
                                            <t t-esc="tag.name"/>
                                        </span>
                                    </t>
                                </div>
                            </t>

                            <!-- Metric bars: CPU/RAM usage + Disk -->
                            <t t-if="hasMetrics(host)">
                                <div class="ic-host-mbars">
                                    <div class="rl-mbar">
                                        <div class="rl-mbar-top">
                                            <span>CPU / RAM</span>
                                            <span><t t-esc="usagePct(host)"/>%</span>
                                        </div>
                                        <div class="rl-mbar-track">
                                            <div t-att-class="'rl-mbar-fill ' + mbarClass(usagePct(host))"
                                                 t-att-style="'width:' + usagePct(host) + '%'"/>
                                        </div>
                                        <t t-if="usageExtra(host)">
                                            <div class="ic-mbar-extra" t-esc="usageExtra(host)"/>
                                        </t>
                                    </div>
                                    <div class="rl-mbar">
                                        <div class="rl-mbar-top">
                                            <span>Disk</span>
                                            <span><t t-esc="host.disk"/>%</span>
                                        </div>
                                        <div class="rl-mbar-track">
                                            <div t-att-class="'rl-mbar-fill ' + mbarClass(host.disk)"
                                                 t-att-style="'width:' + host.disk + '%'"/>
                                        </div>
                                        <t t-if="diskExtra(host)">
                                            <div class="ic-mbar-extra" t-esc="diskExtra(host)"/>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="ic-metrics-placeholder">
                                    No specs yet — run Check from the host page
                                </div>
                            </t>

                            <!-- Footer: instance count · SSH trust · last probed -->
                            <div class="rl-rmeta ic-host-card-foot">
                                <span><t t-esc="host.instance_count"/> instance<t t-if="host.instance_count !== 1">s</t></span>
                                <t t-if="host.has_known_hosts_key">
                                    <span class="ic-ssh-ok"> · SSH ✓</span>
                                </t>
                                <t t-else="">
                                    <span class="ic-ssh-untrusted"> · SSH untrusted</span>
                                </t>
                                <t t-if="host.last_probed">
                                    <span> · <t t-esc="timeAgo(host.last_probed)"/></span>
                                </t>
                            </div>

                        </div>
                    </t>
                </div>
            </t>

        </div>
    </t>

</templates>
