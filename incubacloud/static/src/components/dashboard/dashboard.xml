<templates>

    <t t-name="incubacloud.Overview">
        <div class="ic-overview">

            <!-- Header -->
            <div class="ic-overview-header">
                <h1>Overview</h1>
                <div class="ic-overview-actions">
                    <button class="ic-btn-create" t-on-click="() => this.openCreateProject()">+ New Project</button>
                    <button class="ic-btn-secondary" t-on-click="goToHosts">+ Register Host</button>
                </div>
            </div>

            <!-- KPI cards -->
            <div class="ic-kpis">
                <div class="ic-kpi-card" t-on-click="() => env.navigate('projects')">
                    <span class="ic-kpi-label">Projects</span>
                    <span class="ic-kpi-value" t-esc="state.counts.projects"/>
                </div>
                <div class="ic-kpi-card" t-on-click="() => env.navigate('hosts')">
                    <span class="ic-kpi-label">Hosts</span>
                    <span class="ic-kpi-value" t-esc="state.counts.hosts"/>
                </div>
                <div class="ic-kpi-card">
                    <span class="ic-kpi-label">Instances</span>
                    <span class="ic-kpi-value" t-esc="state.counts.instances"/>
                </div>
                <div t-att-class="'ic-kpi-card' + (state.counts.alerts > 0 ? ' kpi-warning' : ' kpi-ok')">
                    <span class="ic-kpi-label">Active alerts</span>
                    <span class="ic-kpi-value" t-esc="state.counts.alerts"/>
                </div>
            </div>

            <!-- Main grid -->
            <div class="ic-overview-grid">

                <!-- Alerts panel -->
                <div class="ic-panel">
                    <h2>Alerts</h2>
                    <t t-if="state.alerts.length === 0">
                        <div class="ic-empty-state">
                            <i class="fa fa-bell-o ic-empty-icon"/>
                            <div class="ic-empty-title">No active alerts</div>
                            <div class="ic-empty-hint">All systems are running smoothly.</div>
                        </div>
                    </t>
                    <ul class="ic-panel-list">
                        <t t-foreach="state.alerts" t-as="alert" t-key="alert.id">
                            <li t-att-class="'ic-alert-row level-' + alert.level">
                                <i t-att-class="'fa ic-alert-row-icon ' + (alert.level === 'critical' ? 'fa-exclamation-circle' : 'fa-exclamation-triangle')"
                                   t-att-title="alert.level === 'critical' ? 'Critical' : 'Warning'"/>
                                <div class="ic-alert-row-body ic-alert-row-link"
                                     t-on-click="() => this.goToAlert(alert)">
                                    <span class="ic-alert-row-host" t-esc="alert.host"/>
                                    <span class="ic-alert-row-msg" t-esc="alert.message"/>
                                </div>
                                <t t-if="alert.code === 'pip_conflict' or alert.code === 'addon_conflict'">
                                    <span class="ic-alert-row-resolve-hint">Resolve →</span>
                                </t>
                                <t t-else="">
                                    <button class="ic-alert-row-dismiss"
                                            t-on-click.stop="() => this.dismissAlert(alert)">×</button>
                                </t>
                            </li>
                        </t>
                    </ul>
                </div>

                <!-- Recent jobs panel -->
                <div class="ic-panel">
                    <h2>Recent jobs</h2>
                    <t t-if="state.recent_jobs.length === 0">
                        <div class="ic-empty-state">
                            <i class="fa fa-clock-o ic-empty-icon"/>
                            <div class="ic-empty-title">No jobs yet</div>
                            <div class="ic-empty-hint">Jobs will appear here once you deploy or probe a host.</div>
                        </div>
                    </t>
                    <ul class="ic-panel-list">
                        <t t-foreach="state.recent_jobs" t-as="job" t-key="job.id">
                            <li class="ic-job-row">
                                <span t-att-class="'ic-job-state-badge state-' + job.state"
                                      t-esc="jobStateLabel(job.state)"/>
                                <div class="ic-job-row-body">
                                    <span class="ic-job-row-name" t-esc="job.name"/>
                                    <span class="ic-job-row-host" t-esc="job.host"/>
                                </div>
                                <span class="ic-job-row-time" t-esc="timeAgo(job.create_date)"/>
                            </li>
                        </t>
                    </ul>
                </div>

            </div>

        </div>
    </t>

</templates>
