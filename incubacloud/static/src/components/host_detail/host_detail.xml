<templates>

    <t t-name="incubacloud.HostDetail">
        <!-- Root keeps `ic-host-detail` so the saas Traefik-panel patch
             (xpath on `hasclass('ic-host-detail')`) keeps resolving. -->
        <div class="ic-host-detail">

            <!-- Loading -->
            <t t-if="state.loading">
                <div class="ic-rl-detail-scroll">
                    <div class="rl-ovcards">
                        <div class="ic-skeleton-card"/>
                        <div class="ic-skeleton-card"/>
                    </div>
                    <div style="margin-top: 16px;">
                        <div class="ic-skeleton-text ic-skeleton-lg"/>
                        <div class="ic-skeleton-text ic-skeleton-md"/>
                        <div class="ic-skeleton-text ic-skeleton-sm"/>
                    </div>
                </div>
            </t>

            <t t-elif="isNew or state.host">

                <!-- ═══════════════════════════════════════════════════════════
                     Hero: crumb + title + host status badge + subtitle
                     ═══════════════════════════════════════════════════════════ -->
                <div class="rl-crumb">
                    <a t-on-click="goBack">Hosts</a>
                    <span class="rl-sep">/</span>
                    <span class="rl-cur">
                        <t t-if="isNew">New host</t>
                        <t t-else="" t-esc="state.host.name"/>
                    </span>
                </div>

                <div class="rl-phead ic-rl-hero">
                    <div class="rl-htext">
                        <h1 class="rl-ptitle">
                            <t t-if="isNew">New Host</t>
                            <t t-else="">
                                <t t-esc="state.host.name"/>
                                <span t-att-class="'rl-sb ' + hostSbClass(state.host.status)">
                                    <span class="rl-d"/><t t-esc="statusLabel(state.host.status)"/>
                                </span>
                                <t t-if="state.host.config_dirty">
                                    <span
                      class="rl-pill pending"
                      title="Saved host configuration differs from what the last full setup shipped. Re-run full setup to apply it."
                    >
                                        Changes not applied
                                    </span>
                                </t>
                            </t>
                        </h1>
                        <t t-if="!isNew">
                            <p class="rl-psub">
                                <code class="ic-host-ip">
                                    <t t-esc="state.host.ip_address"/>:<t t-esc="state.host.port || 22"/>
                                </code>
                                ·
                                <t t-esc="state.host.instance_count"/> instance<t t-if="state.host.instance_count !== 1">s</t>
                            </p>
                        </t>
                    </div>
                </div>

                <!-- ═══════════════════════════════════════════════════════════
                     Action bar (existing hosts only, Manager only)
                     Keeps `ic-action-bar` so the saas terminal / retry
                     patches (xpath on `hasclass('ic-action-bar')`) resolve.
                     ═══════════════════════════════════════════════════════════ -->
                <t t-if="!isNew and state.host and env.permissions?.can_manage_hosts">
                    <div class="rl-abar ic-action-bar">
                        <button class="rl-btn rl-btn-primary" title="Check host"
                                t-on-click="runCheck">
                            <t t-out="env.icon('refresh', 15)"/> Check
                        </button>
                        <button class="rl-btn rl-btn-ghost" title="Full setup"
                                t-on-click="runFullSetup">
                            <t t-out="env.icon('settings', 15)"/> Full Setup
                        </button>
                        <button class="rl-btn rl-btn-ghost" title="Import existing instance"
                                t-on-click="openImportBrowser">
                            <t t-out="env.icon('download', 15)"/> Import Instance
                        </button>
                        <!-- Community / extension actions -->
                        <t t-if="state.host.custom_actions?.length">
                            <span class="rl-asep"/>
                            <t t-foreach="state.host.custom_actions" t-as="action" t-key="action.code">
                                <button class="rl-iconbtn"
                                        t-att-title="action.name"
                                        t-att-aria-label="action.name"
                                        t-on-click="() => this.hostAction(action.code)">
                                    <i t-att-class="'fa ' + (action.action_icon || 'fa-cog')"/>
                                </button>
                            </t>
                        </t>
                        <span class="rl-asep"/>
                        <button t-att-class="'rl-btn rl-btn-ghost' + (state.has_known_hosts_key ? '' : ' ic-ab-warn')"
                                t-att-title="state.has_known_hosts_key ? 'Re-trust SSH host key' : 'Trust SSH host key (required before any SSH operation)'"
                                t-att-disabled="state.trusting_host_key || null"
                                t-on-click="trustHostKey">
                            <i t-if="state.trusting_host_key" class="fa fa-spinner fa-spin"/>
                            <i t-else="" class="fa fa-shield"/>
                            <t t-if="state.has_known_hosts_key"> Re-trust Key</t>
                            <t t-else=""> Trust SSH Key</t>
                        </button>
                    </div>
                </t>

                <!-- ═══════════════════════════════════════════════════════════
                     Tabs — keeps `ic-detail-tabs` so the saas Security patch
                     (xpath on `hasclass('ic-detail-tabs')`) resolves.
                     ═══════════════════════════════════════════════════════════ -->
                <div class="rl-tabs ic-detail-tabs">
                    <t t-if="!isNew">
                        <button t-att-class="state.tab === 'overview' ? 'rl-tab active' : 'rl-tab'"
                                t-on-click="() => this.setTab('overview')">Overview</button>
                    </t>
                    <button t-att-class="state.tab === 'general' ? 'rl-tab active' : 'rl-tab'"
                            t-on-click="() => this.setTab('general')">General</button>
                    <button t-att-class="state.tab === 'connection' ? 'rl-tab active' : 'rl-tab'"
                            t-on-click="() => this.setTab('connection')">Connection</button>
                    <button t-att-class="state.tab === 'traefik' ? 'rl-tab active' : 'rl-tab'"
                            t-on-click="() => this.setTab('traefik')">Traefik</button>
                    <button t-att-class="state.tab === 'whitelist' ? 'rl-tab active' : 'rl-tab'"
                            t-on-click="() => this.setTab('whitelist')">Whitelist</button>
                    <t t-if="!isNew and env.permissions?.can_manage_hosts">
                        <button t-att-class="state.tab === 'activity' ? 'rl-tab active' : 'rl-tab'"
                                t-on-click="() => this.setTab('activity')">Audit Logs</button>
                    </t>
                </div>

                <!-- ═══════════════════════════════════════════════════════════
                     Scrolling body
                     ═══════════════════════════════════════════════════════════ -->
                <div class="ic-rl-detail-scroll">

                    <!-- ── Overview ───────────────────────────────────────── -->
                    <t t-if="!isNew and state.tab === 'overview' and state.host">
                        <div class="rl-ovcards">

                            <!-- Status -->
                            <div class="rl-ovcard">
                                <div class="rl-ovtitle">Status</div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">State</span>
                                    <span t-att-class="'rl-v ' + hostVClass(state.host.status)">
                                        <t t-esc="statusLabel(state.host.status)"/>
                                    </span>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">CPU</span>
                                    <span class="rl-v">
                                        <t t-if="state.host.cpu_cores" t-esc="state.host.cpu_cores + ' cores'"/>
                                        <t t-else="">—</t>
                                    </span>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">RAM</span>
                                    <span class="rl-v" t-esc="formatRam(state.host.ram_total_gb)"/>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">Disk</span>
                                    <t t-if="state.host.disk">
                                        <span t-att-class="'rl-v' + (state.host.disk >= 85 ? ' crit' : '')">
                                            <t t-esc="state.host.disk + '%'"/>
                                            <t t-if="diskExtra()">
                                                <span class="rl-ov-sub" t-esc="diskExtra()"/>
                                            </t>
                                        </span>
                                    </t>
                                    <t t-else=""><span class="rl-v muted">—</span></t>
                                </div>
                            </div>

                            <!-- Info -->
                            <div class="rl-ovcard">
                                <div class="rl-ovtitle">Info</div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">Domain</span>
                                    <span class="rl-v" t-esc="state.host.wildcard_domain || '—'"/>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">Instances</span>
                                    <span class="rl-v" t-esc="state.host.instance_count"/>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">Traefik</span>
                                    <t t-if="state.host.traefik_deployed">
                                        <span class="rl-v ok">Deployed</span>
                                    </t>
                                    <t t-else=""><span class="rl-v muted">Not deployed</span></t>
                                </div>
                                <div class="rl-ovrow">
                                    <span class="rl-l">SSH Key</span>
                                    <t t-if="state.has_known_hosts_key">
                                        <span class="rl-v ok"><t t-out="env.icon('shield', 13)"/> Trusted</span>
                                    </t>
                                    <t t-else="">
                                        <span class="rl-v warn"><t t-out="env.icon('alert', 13)"/> Not trusted</span>
                                    </t>
                                </div>
                                <!-- The fingerprint is the only thing an
                                     operator can compare this host's identity
                                     against, so it is readable here instead of
                                     living solely in the server log. -->
                                <div class="rl-ovrow" t-if="state.host.known_hosts_fingerprint">
                                    <span class="rl-l">Key fingerprint</span>
                                    <span class="rl-v rl-mono" t-esc="state.host.known_hosts_fingerprint"/>
                                </div>
                                <div class="rl-ovrow" t-if="state.host.revoked_key_fingerprint">
                                    <span class="rl-l">Revoked key</span>
                                    <span class="rl-v warn rl-mono"
                                          title="Fingerprint the host was trusted with before its endpoint changed. Re-trust the key: an identical fingerprint means the machine did not change."
                                          t-esc="state.host.revoked_key_fingerprint"/>
                                </div>
                                <t t-if="state.host.last_probed">
                                    <div class="rl-ovrow">
                                        <span class="rl-l">Last check</span>
                                        <span class="rl-v" t-esc="timeAgo(state.host.last_probed)"/>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Recent Activity timeline -->
                        <p class="rl-tlh">Recent activity</p>
                        <t t-if="state.jobsLoading and !state.jobs.length">
                            <div class="ic-ov-activity-loading">
                                <div class="ic-skeleton-row">
                                    <div class="ic-skeleton-label"/>
                                    <div class="ic-skeleton-value"/>
                                </div>
                                <div class="ic-skeleton-row">
                                    <div class="ic-skeleton-label"/>
                                    <div class="ic-skeleton-value"/>
                                </div>
                            </div>
                        </t>
                        <t t-elif="!state.jobs.length">
                            <div class="ic-ov-activity-empty">No activity yet.</div>
                        </t>
                        <t t-else="">
                            <div class="rl-tl">
                                <t t-foreach="state.jobs.slice(0, 4)" t-as="job" t-key="job.id">
                                    <div class="rl-tl-item" t-on-click="() => this.openLog(job)">
                                        <div class="rl-tl-rail">
                                            <span t-att-class="'rl-tl-dot ' + (jobStateClass(job.state) === 'jst-done' ? 'done' : jobStateClass(job.state) === 'jst-failed' ? 'failed' : (isActiveJob(job.state) ? 'running' : (job.state === 'pending' ? 'queued' : '')))"/>
                                            <span class="rl-tl-line"/>
                                        </div>
                                        <div class="rl-tl-content">
                                            <div class="rl-tl-head">
                                                <span class="rl-tl-icon"><i t-att-class="'fa ' + jobIcon(job.job_type_code)"/></span>
                                                <span class="rl-tl-name" t-esc="job.name"/>
                                                <span t-att-class="'rl-tl-state ' + (jobStateClass(job.state) === 'jst-done' ? 'done' : jobStateClass(job.state) === 'jst-failed' ? 'failed' : 'queued')"
                                                      t-esc="job.state"/>
                                                <t t-if="job.requires_action">
                                                    <span class="ic-tl-alert-badge"
                                                          t-on-click.stop="() => env.toggleSlideOver('alerts')">
                                                        <t t-out="env.icon('alert', 13)"/> Action required
                                                    </span>
                                                </t>
                                                <span class="rl-tl-loghint"><t t-out="env.icon('terminal', 12)"/> Log</span>
                                            </div>
                                            <t t-if="job.last_system_message">
                                                <div class="rl-tl-msg" t-esc="job.last_system_message"/>
                                            </t>
                                            <div class="rl-tl-foot">
                                                <span class="rl-when">
                                                    <t t-esc="formatDate(job.create_date)"/>
                                                    <t t-esc="' (' + timeAgo(job.create_date) + ')'"/>
                                                </span>
                                                <div class="rl-acts">
                                                    <t t-if="isActiveJob(job.state)">
                                                        <button class="rl-tl-abtn"
                                                                t-on-click="(ev) => this.cancelJob(ev, job)">
                                                            <t t-out="env.icon('x', 11)"/> Cancel
                                                        </button>
                                                    </t>
                                                    <t t-if="job.state === 'failed'">
                                                        <button class="rl-tl-abtn"
                                                                t-on-click="(ev) => this.retryJob(ev, job)">
                                                            <t t-out="env.icon('refresh', 11)"/> Retry
                                                        </button>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <t t-if="hasMoreJobs or state.jobs.length > 4">
                                <button class="rl-btn rl-btn-ghost" style="margin-top:6px" t-on-click="viewAllJobs">
                                    View all activity <t t-out="env.icon('fwd', 15)"/>
                                </button>
                            </t>
                        </t>
                    </t>

                    <!-- ── Config tabs (everything except overview) ───────── -->
                    <t t-if="state.tab !== 'overview'">

                        <!-- ── General tab ──────────────────────────────────────── -->
                        <t t-if="state.tab === 'general'">
                            <!-- Keeps `ic-form-grid` so the saas warm_pool /
                                 pool_host patches (xpath on this grid) resolve. -->
                            <div class="rl-fgrid ic-form-grid">
                                <div class="rl-frow"
                                     t-att-class="validator.fieldError('name') ? 'has-error' : ''">
                                    <label>Name <span class="rl-req">*</span></label>
                                    <input
                    t-att-aria-invalid="validator.fieldError('name') ? 'true' : undefined"
                    t-att-aria-describedby="validator.fieldError('name') ? 'hd-err-name' : undefined"
                                           t-att-value="state.form.name"
                                           t-on-input="(ev) => this.onInput('name', ev)"
                                           t-on-blur="() => validator.touch('name')"/>
                                    <t t-if="validator.fieldError('name')">
                                        <span class="ic-field-error"
                      t-att-id="'hd-err-name'" t-esc="validator.fieldError('name')"/>
                                    </t>
                                </div>
                                <div class="rl-frow"
                                     t-att-class="validator.fieldError('ip_address') ? 'has-error' : ''">
                                    <label>IP Address <span class="rl-req">*</span></label>
                                    <input
                    t-att-aria-invalid="validator.fieldError('ip_address') ? 'true' : undefined"
                    t-att-aria-describedby="validator.fieldError('ip_address') ? 'hd-err-ip_address' : undefined"
                                           t-att-value="state.form.ip_address"
                                           t-on-input="(ev) => this.onInput('ip_address', ev)"
                                           t-on-blur="() => validator.touch('ip_address')"/>
                                    <t t-if="validator.fieldError('ip_address')">
                                        <span class="ic-field-error"
                      t-att-id="'hd-err-ip_address'" t-esc="validator.fieldError('ip_address')"/>
                                    </t>
                                </div>
                                <div class="rl-frow"
                                     t-att-class="validator.fieldError('port') ? 'has-error' : ''">
                                    <label>Port <span class="rl-req">*</span></label>
                                    <input
                    t-att-aria-invalid="validator.fieldError('port') ? 'true' : undefined"
                    t-att-aria-describedby="validator.fieldError('port') ? 'hd-err-port' : undefined" type="number"
                                           t-att-value="state.form.port"
                                           t-on-input="(ev) => this.onInput('port', ev)"
                                           t-on-blur="() => validator.touch('port')"/>
                                    <t t-if="validator.fieldError('port')">
                                        <span class="ic-field-error"
                      t-att-id="'hd-err-port'" t-esc="validator.fieldError('port')"/>
                                    </t>
                                </div>
                                <div class="rl-frow rl-full">
                                    <label>Tags</label>
                                    <TagSelector
                                        selected="state.selectedTags"
                                        available="state.allTags"
                                        onAdd.bind="addTag"
                                        onRemove.bind="removeTag"
                                        onCreate.bind="createTag"
                                    />
                                </div>
                                <div class="rl-frow rl-full">
                                    <label>Description</label>
                                    <textarea rows="4"
                                              t-att-value="state.form.description"
                                              t-on-input="(ev) => this.onInput('description', ev)"/>
                                </div>
                                <div class="rl-frow rl-full">
                                    <label>Auto-assignment</label>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <input
                                               t-att-checked="state.form.exclude_from_autoassign"
                                               t-on-change="(ev) => { this.state.form.exclude_from_autoassign = ev.target.checked; }"/>
                                        <span>Exclude from auto-assignment</span>
                                    </div>
                                    <span class="ic-form-note">
                                        When checked, this host will not be selected automatically for new instances.
                                    </span>
                                </div>
                            </div>
                        </t>

                        <!-- ── Connection tab ───────────────────────────────────── -->
                        <t t-if="state.tab === 'connection'">
                            <div class="rl-fgrid">
                                <div class="rl-frow"
                                     t-att-class="validator.fieldError('user') ? 'has-error' : ''">
                                    <label>User <span class="rl-req">*</span></label>
                                    <input
                    t-att-aria-invalid="validator.fieldError('user') ? 'true' : undefined"
                    t-att-aria-describedby="validator.fieldError('user') ? 'hd-err-user' : undefined" type="text" placeholder="ubuntu"
                                           t-att-value="state.form.user"
                                           t-on-input="(ev) => this.onInput('user', ev)"
                                           t-on-blur="() => validator.touch('user')"/>
                                    <t t-if="validator.fieldError('user')">
                                        <span class="ic-field-error"
                      t-att-id="'hd-err-user'" t-esc="validator.fieldError('user')"/>
                                    </t>
                                </div>
                                <div class="rl-frow">
                                    <label>Login Type <span class="rl-req">*</span></label>
                                    <RlSelect value="state.form.login_type"
                                              options="[{value:'ssh_key',label:'SSH Key'},{value:'password',label:'Password'}]"
                                              onChange="(value) => this.onSelect('login_type', { target: { value: value } })"
                                              ariaLabel="'Login type'"/>
                                </div>
                                <t t-if="state.form.login_type === 'password'">
                                    <div class="rl-frow rl-full">
                                        <label>Password</label>
                                        <PasswordInput
                                            hasValue="state.has_password"
                                            required="true"
                                            onChange="(val) => this.onPasswordChange('password', val)"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="rl-frow rl-full">
                                        <label>SSH Private Key <span class="rl-req">*</span></label>
                                        <input
                                               t-on-change="onKeyFileChange"/>
                                        <t t-if="!isNew and state.has_key_file and !state.form.key_file">
                                            <span class="ic-form-note ic-form-note--set">
                                                <t t-out="env.icon('check', 15)"/> Key stored — upload a new file only to replace it.
                                            </span>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- ── Traefik tab ──────────────────────────────────────── -->
                        <t t-if="state.tab === 'traefik'">
                            <!-- Keeps `ic-traefik-meta` so the saas DNS patch
                                 (xpath on this grid) resolves. -->
                            <div class="rl-fgrid ic-traefik-meta">
                                <div class="rl-frow"
                                     t-att-class="validator.fieldError('wildcard_domain') ? 'has-error' : ''">
                                    <label>Wildcard Domain <span class="rl-req">*</span></label>
                                    <input
                    t-att-aria-invalid="validator.fieldError('wildcard_domain') ? 'true' : undefined"
                    t-att-aria-describedby="validator.fieldError('wildcard_domain') ? 'hd-err-wildcard_domain' : undefined" type="text" placeholder="example.com"
                                           t-att-value="state.form.wildcard_domain"
                                           t-on-input="(ev) => this.onInput('wildcard_domain', ev)"
                                           t-on-blur="() => validator.touch('wildcard_domain')"/>
                                    <t t-if="validator.fieldError('wildcard_domain')">
                                        <span class="ic-field-error"
                      t-att-id="'hd-err-wildcard_domain'" t-esc="validator.fieldError('wildcard_domain')"/>
                                    </t>
                                </div>
                                <div class="rl-frow">
                                    <label>Panel Password</label>
                                    <PasswordInput
                                        hasValue="state.has_traefik_panel_password"
                                        onChange="(val) => this.onPasswordChange('traefik_panel_password', val)"/>
                                </div>
                            </div>
                            <div class="ic-file-tabs">
                                <t t-foreach="traefikFiles" t-as="f" t-key="f.key">
                                    <button t-att-class="state.traefik_file === f.key ? 'ic-file-tab active' : 'ic-file-tab'"
                                            t-on-click="() => this.setTraefikFile(f.key)">
                                        <t t-esc="f.label"/>
                                    </button>
                                </t>
                            </div>
                            <div class="ic-code-editor-wrap">
                                <div class="ic-code-gutter">
                                    <t t-foreach="getLineNumbers(state.traefik_file)" t-as="n" t-key="n">
                                        <div class="ic-line-num" t-esc="n"/>
                                    </t>
                                </div>
                                <textarea class="ic-code-area" spellcheck="false"
                                          autocomplete="off" autocorrect="off" autocapitalize="off"
                                          t-att-value="state.form[state.traefik_file]"
                                          t-on-input="(ev) => this.onInput(state.traefik_file, ev)"
                                          t-on-scroll="onCodeScroll"/>
                            </div>
                        </t>

                        <!-- ── Whitelist tab ────────────────────────────────────── -->
                        <!-- Keep the exact `state.tab === 'whitelist'` t-if as the
                             anchor the saas Security patch appends after. -->
                        <t t-if="state.tab === 'whitelist'">
                            <div class="ic-whitelist-panel">
                                <p class="rl-tabnote">
                                    Hostnames that test instances on this host can reach
                                    through the <code>globalwhitelist</code> proxy.
                                    Click <strong>Apply Whitelist</strong> to push changes.
                                </p>
                                <div class="rl-card ic-whitelist-card">
                                    <t t-foreach="state.form.whitelist" t-as="hostname" t-key="hostname">
                                        <div class="rl-row ic-whitelist-item">
                                            <span class="rl-mono ic-whitelist-hostname" t-esc="hostname"/>
                                            <span class="rl-rspacer"/>
                                            <button class="rl-iconbtn danger" title="Remove"
                                                    t-on-click="() => this.removeWhitelistEntry(hostname)">
                                                <t t-out="env.icon('x', 14)"/>
                                            </button>
                                        </div>
                                    </t>
                                    <t t-if="state.form.whitelist.length === 0">
                                        <div class="ic-whitelist-empty">No hosts in whitelist.</div>
                                    </t>
                                </div>
                                <div class="ic-whitelist-add">
                                    <input type="text" placeholder="e.g. api.example.com"
                                           t-att-value="state.form.newWhitelistEntry"
                                           t-on-input="(ev) => { state.form.newWhitelistEntry = ev.target.value; }"
                                           t-on-keydown="onWhitelistKeydown"/>
                                    <button class="rl-btn rl-btn-ghost"
                                            t-on-click="() => this.addWhitelistEntry()">
                                        <t t-out="env.icon('plus', 15)"/> Add
                                    </button>
                                </div>
                                <t t-if="!isNew">
                                    <div class="ic-whitelist-apply-row">
                                        <button class="rl-btn rl-btn-primary" t-on-click="applyWhitelist">
                                            <i class="fa fa-upload"/> Apply Whitelist on Host
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- ── Audit Logs ───────────────────────────────────── -->
                        <t t-if="state.tab === 'activity'">
                            <div class="ic-activity-panel">

                                <!-- Filter bar -->
                                <div class="ic-audit-filters">
                                    <input class="ic-audit-search" type="text"
                                           placeholder="Search user or action…"
                                           t-att-value="state.auditFilter.q"
                                           t-on-input="(ev) => { state.auditFilter.q = ev.target.value; }"/>
                                    <div class="ic-audit-select" style="max-width:240px">
                                        <RlSelect options="state.auditActions"
                                                  emptyLabel.translate="All actions"
                                                  value="state.auditFilter.action"
                                                  onChange="(value) => { state.auditFilter.action = value; }"
                                                  ariaLabel="'Filter by action'"/>
                                    </div>
                                    <input class="ic-audit-date" type="date"
                                           t-att-value="state.auditFilter.date_from"
                                           t-on-change="(ev) => { state.auditFilter.date_from = ev.target.value; }"/>
                                    <span class="ic-audit-date-sep">→</span>
                                    <input class="ic-audit-date" type="date"
                                           t-att-value="state.auditFilter.date_to"
                                           t-on-change="(ev) => { state.auditFilter.date_to = ev.target.value; }"/>
                                    <button class="rl-btn rl-btn-ghost rl-btn-sm" t-on-click="applyAuditFilter">Apply</button>
                                    <button class="rl-btn rl-btn-ghost rl-btn-sm" t-on-click="resetAuditFilter">Reset</button>
                                    <div class="ic-audit-spacer"/>
                                    <IcPager offset="state.auditOffset" limit="pageSize"
                                             total="state.auditTotal"
                                             onPage="(o) => this.auditGoPage(o)"/>
                                </div>

                                <t t-if="state.auditLogLoading">
                                    <div class="history-loading">Loading…</div>
                                </t>
                                <t t-elif="!state.auditLog.length">
                                    <div class="rl-stub">
                                        <span class="rl-si"><i class="fa fa-history"/></span>
                                        <h3>No entries found</h3>
                                        <p>No audit log entries match the current filters.</p>
                                    </div>
                                </t>
                                <t t-else="">
                                    <table class="rl-table rl-table--audit">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>User</th>
                                                <th>Action</th>
                                                <th>Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.auditLog" t-as="entry" t-key="entry.id">
                                                <tr>
                                                    <td class="rl-mono" t-esc="formatDate(entry.create_date)"/>
                                                    <td t-esc="entry.user_name"/>
                                                    <td class="rl-mono" t-esc="entry.action"/>
                                                    <td t-esc="entry.details || '—'"/>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </t>

                    </t>

                </div>

                <!-- Footer: purge (activity tab) or save/delete (config tabs); hidden on overview -->
                <t t-if="state.tab !== 'overview'">
                    <div class="rl-formfoot">
                        <t t-if="state.tab === 'activity'">
                            <button class="ic-audit-purge-btn"
                                    t-att-disabled="state.auditPurging"
                                    title="Delete entries older than the configured retention period"
                                    t-on-click="purgeAuditLogs">
                                <i t-att-class="'fa ' + (state.auditPurging ? 'fa-spinner fa-spin' : 'fa-trash-o')"/>
                                Purge old logs
                            </button>
                        </t>
                        <t t-else="">
                            <t t-if="!isNew and env.permissions?.can_manage_hosts">
                                <button class="rl-btn rl-btn-danger ic-formfoot-delete" t-on-click="deleteHost">
                                    <t t-out="env.icon('trash', 15)"/> Delete
                                </button>
                            </t>
                            <span class="rl-ff-hint">Fill in the required fields *</span>
                            <button class="rl-btn rl-btn-primary"
                                    t-att-disabled="state.saving"
                                    t-on-click="save">
                                <t t-if="state.saving">
                                    <i class="fa fa-spinner fa-spin" style="margin-right:5px"/>
                                    <t t-if="isNew">Creating…</t>
                                    <t t-else="">Saving…</t>
                                </t>
                                <t t-else="">
                                    <t t-if="isNew">Create Host</t>
                                    <t t-else="">Save changes</t>
                                </t>
                            </button>
                        </t>
                    </div>
                </t>

            </t>

            <!-- Error state -->
            <t t-elif="state.error">
                <div class="ic-detail-error-state" role="alert">
                    <p t-esc="state.error"/>
                    <button t-on-click="goBack">← Back to Hosts</button>
                </div>
            </t>

            <!-- Import instance file browser -->
            <t t-if="state.showImportBrowser and props.host_id">
                <RemoteFileBrowser
                    hostId="props.host_id"
                    onSelect="(r) => this.onImportSelect(r)"
                    onCancel="() => this.closeImportBrowser()"/>
            </t>

            <!-- Confirm dialog -->
            <IcConfirmDialog t-if="state.confirmDialog"
                             title="state.confirmDialog.title"
                             message="state.confirmDialog.message"
                             confirmLabel="state.confirmDialog.confirmLabel"
                             isDanger="state.confirmDialog.isDanger"
                             onConfirm="state.confirmDialog.onConfirm"
                             onCancel="state.confirmDialog.onCancel"/>

        </div>
    </t>

</templates>
