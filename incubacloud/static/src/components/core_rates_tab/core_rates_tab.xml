<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="incubacloud.CoreRatesTab">
    <t t-if="state.loading">
        <div class="ic-detail-loading">Loading…</div>
    </t>
    <t t-else="">

        <div class="rl-saas-fsec">Rate limits for core endpoints</div>
        <p class="rl-tabnote">
            Protect the GitHub webhook, the terminal opener and
            connect-as against CPU DoS and resource exhaustion. All values
            are requests per minute, tumbling window. Changes
            apply immediately — no redeploy needed. Set any
            field to a non-positive number and the model will
            fall back to the documented default.
        </p>

        <div class="rl-fgrid">
            <div class="rl-frow">
                <label>GitHub webhook (per client IP)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_webhook_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_webhook_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Terminal open (per instance)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_terminal_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_terminal_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Terminal open (per user)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_terminal_user_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_terminal_user_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Connect as user (per instance)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_connect_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_connect_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Connect as user (per user)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_connect_user_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_connect_user_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Log reads (per user)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_logs_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_logs_per_min', ev)"/>
            </div>
            <div class="rl-frow">
                <label>Log searches and downloads (per user)</label>
                <input type="number" min="1" style="width:120px;"
                       t-att-value="state.form.rate_limit_log_search_per_min"
                       t-on-change="(ev) => this.onIntInput('rate_limit_log_search_per_min', ev)"/>
            </div>
        </div>

    </t>
</t>

</templates>
