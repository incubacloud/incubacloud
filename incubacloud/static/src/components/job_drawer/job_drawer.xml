<t t-name="incubacloud.JobDrawer">
    <aside class="job-panel">

        <!-- Header -->
        <div class="job-panel-header">
            <span class="job-panel-title">
                <t t-out="env.icon('clock', 15)"/> Jobs
            </span>
            <t t-if="runningCount">
                <span class="job-panel-running">
                    <span class="rl-spin"/>
                    <t t-esc="runningCount"/>
                </span>
            </t>
        </div>

        <!-- Timeline -->
        <div class="job-list">
            <t t-if="!state.jobs.length">
                <div class="job-panel-empty">No recent jobs</div>
            </t>
            <div class="rl-tl">
                <t t-foreach="state.jobs" t-as="job" t-key="job.id">
                    <div t-att-class="'rl-tl-item rl-tl-item--static job-entry ' + jobClass(job)">

                        <!-- Rail: dot + connecting line -->
                        <div class="rl-tl-rail">
                            <span t-att-class="'rl-tl-dot ' + dotClass(job)"/>
                            <span class="rl-tl-line"/>
                        </div>

                        <!-- Content -->
                        <div class="rl-tl-content">

                            <!-- Name + state + date -->
                            <div class="rl-tl-head">
                                <span class="rl-tl-name" t-esc="job.name"/>
                                <span t-att-class="'rl-tl-state ' + stateClass(job)" t-esc="stateName(job)"/>
                                <span class="rl-tl-loghint" t-esc="formatDate(job.create_date)"/>
                            </div>

                            <!-- Webhook trigger -->
                            <t t-if="job.trigger === 'webhook'">
                                <div class="rl-tl-trigger">
                                    <i class="fa fa-github"/>
                                    <span class="rl-sha" t-esc="job.push_sha"/>
                                    <t t-esc="job.push_message"/>
                                </div>
                            </t>

                            <!-- Host + user -->
                            <div class="rl-tl-msg job-meta">
                                <span t-esc="job.host"/>
                                <t t-if="job.user_name">
                                    <span class="job-meta-sep"> · </span>
                                    <span class="job-meta-user" t-esc="job.user_name"/>
                                </t>
                            </div>

                            <!-- System progress message -->
                            <t t-if="job.last_system_message">
                                <div class="rl-tl-msg job-message">
                                    <span class="job-message-arrow">↳</span>
                                    <span t-esc="job.last_system_message"/>
                                </div>
                            </t>

                            <!-- Actions -->
                            <div class="rl-tl-foot">
                                <div class="rl-acts">
                                    <button class="rl-tl-abtn" t-on-click="() => this.openLog(job)">
                                        <i class="fa fa-file-text-o"/> Log
                                    </button>
                                    <t t-if="['pending', 'enqueued', 'wait_dependencies', 'started'].includes(job.state)">
                                        <button class="rl-tl-abtn danger" t-on-click="() => this.cancelJob(job)">
                                            <t t-out="env.icon('x', 15)"/> Cancel
                                        </button>
                                    </t>
                                    <t t-if="job.state === 'failed'">
                                        <button class="rl-tl-abtn" t-on-click="() => this.retryJob(job)">
                                            <t t-out="env.icon('refresh', 15)"/> Retry
                                        </button>
                                    </t>
                                    <t t-if="job.state === 'blocked'">
                                        <button class="rl-tl-abtn" t-on-click="() => env.toggleSlideOver('alerts')">
                                            <t t-out="env.icon('alert', 15)"/> Resolve
                                        </button>
                                    </t>
                                    <t t-if="job.state === 'done' and job.download_url">
                                        <a class="rl-tl-abtn job-download-btn" t-att-href="job.download_url" download="">
                                            <t t-out="env.icon('download', 15)"/> Download
                                        </a>
                                    </t>
                                </div>
                            </div>

                        </div>

                    </div>
                </t>
            </div>
        </div>

        <!-- Footer -->
        <div class="job-panel-footer">
            <button class="link" t-on-click="goToHistory">
                <i class="fa fa-list"/> View all jobs
            </button>
        </div>

        <!-- Confirm dialog -->
        <IcConfirmDialog t-if="state.confirmDialog"
                         title="state.confirmDialog.title"
                         message="state.confirmDialog.message"
                         confirmLabel="state.confirmDialog.confirmLabel"
                         isDanger="state.confirmDialog.isDanger"
                         onConfirm="state.confirmDialog.onConfirm"
                         onCancel="state.confirmDialog.onCancel"/>

    </aside>
</t>
