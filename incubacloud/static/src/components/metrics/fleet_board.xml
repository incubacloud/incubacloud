<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="incubacloud.FleetBoard">
        <div class="ic-mb ic-fb">
            <t t-if="!state.board">
                <t t-call="incubacloud.ChartBoardStates"/>
            </t>
            <t t-else="">
                <t t-call="incubacloud.ChartBoardBusy"/>
                <!-- Figures -->
                <section class="ic-mb-section" aria-labelledby="ic-fb-now">
                    <div class="ic-mb-head">
                        <div>
                            <h3 class="ic-mb-h" id="ic-fb-now">The fleet now<span class="ic-fb-scope" t-esc="scopeText"/></h3>
                        </div>
                        <t t-call="incubacloud.ChartBoardRange"/>
                    </div>
                    <div class="ic-fb-tiles">
                        <t t-foreach="tiles" t-as="tile" t-key="tile.key">
                            <div t-att-class="'rl-card ic-fb-tile is-' + tile.tone" t-att-data-tile="tile.key">
                                <span class="ic-fb-tile-value" t-esc="tile.value"/>
                                <span class="ic-fb-tile-label" t-esc="tile.label"/>
                            </div>
                        </t>
                    </div>
                    <p t-if="!hasData" class="ic-mb-empty" t-att-data-silence="state.board.silence?.code">
                        <span>No data for this period.</span> <t t-esc="silenceText"/>
                    </p>
                </section>

                <!-- Security: figures only; the detail is in each server -->
                <section t-if="security.state" class="ic-mb-section" aria-labelledby="ic-fb-security"
                         t-att-data-security="security.state">
                    <h3 class="ic-mb-h" id="ic-fb-security">Security</h3>
                    <t t-if="security.state === 'unavailable'">
                        <div class="ic-mb-empty ic-fb-sec-off">
                            <p class="ic-fb-sec-title">Security logs are not available on this panel yet</p>
                            <p>Its servers do not send their security logs until the panel's provider allows them.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="ic-mb-sub">Figures only: who tried and from where is in each server's Metrics tab, under Security.</p>
                        <p t-if="panelError('security')" class="ic-mb-empty ic-mb-panel-error" t-esc="panelError('security')"/>
                        <div class="ic-fb-tiles" data-panel="security">
                            <t t-foreach="securityTiles" t-as="tile" t-key="tile.key">
                                <div t-att-class="'rl-card ic-fb-tile is-' + tile.tone" t-att-data-tile="tile.key">
                                    <span class="ic-fb-tile-value" t-esc="tile.value"/>
                                    <span class="ic-fb-tile-label" t-esc="tile.label"/>
                                </div>
                            </t>
                        </div>
                        <div class="ic-fb-sec-grid">
                            <t t-set="c" t-value="securityCard"/>
                            <t t-call="incubacloud.ChartBoardCard"/>
                            <div class="rl-card rl-card-pad" data-panel="security_hosts">
                                <div class="ic-mb-cardhead">
                                    <span class="rl-ovtitle">Servers to look at</span>
                                    <span class="ic-mb-hint">this panel's own</span>
                                </div>
                                <ul t-if="securityRows.length" class="ic-fb-sec-list">
                                    <t t-foreach="securityRows" t-as="row" t-key="row.host_id">
                                        <li class="ic-fb-sec-row" t-att-data-host="row.host_id">
                                            <span class="ic-fb-sec-name">
                                                <a t-if="canOpenHost(row)" href="#" class="ic-hb-link"
                                                   t-on-click.prevent="() => this.openHost(row)" t-esc="row.name"/>
                                                <t t-else="" t-esc="row.name"/>
                                            </span>
                                            <span class="ic-fb-sec-flags">
                                                <t t-foreach="securityFlags(row)" t-as="flag" t-key="flag.key">
                                                    <span t-att-class="'ic-fb-sec-flag is-' + flag.tone" t-att-data-flag="flag.key" t-esc="flag.text"/>
                                                </t>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                                <p t-else="" class="ic-mb-empty">No server of this panel has anything to look at.</p>
                                <p t-if="security.hidden" class="ic-mb-empty" t-esc="securityHiddenText"/>
                            </div>
                        </div>
                    </t>
                </section>

                <!-- Busiest servers, and whether each one reports: the
                     ingestion line takes the room the charts leave on
                     their last row (``ic-mb-fill``). -->
                <section class="ic-mb-section" aria-labelledby="ic-fb-busiest">
                    <h3 class="ic-mb-h" id="ic-fb-busiest">Busiest servers</h3>
                    <p class="ic-mb-sub">
                        <t t-if="isZoomed">Zoomed window.</t>
                        <t t-else="">Drag across a chart to zoom.</t>
                    </p>
                    <div t-att-class="'ic-mb-grid ic-mb-fill' + (state.loading ? ' is-loading' : '')" t-att-aria-busy="state.loading ? 'true' : 'false'">
                        <t t-foreach="cards" t-as="c" t-key="c.key">
                            <t t-call="incubacloud.ChartBoardCard"/>
                        </t>
                        <div class="rl-card ic-mb-card ic-mb-span2" data-panel="ingest">
                            <div class="ic-mb-cardhead">
                                <span class="rl-ovtitle" id="ic-fb-ingest">Are the servers reporting?</span>
                                <span class="ic-mb-hint">
                                    a sample at each step of the window
                                    <span class="ic-fb-legend"><span class="ic-fb-legend-ok" aria-hidden="true"/>reporting</span>
                                    <span class="ic-fb-legend"><span class="ic-fb-legend-silent" aria-hidden="true"/>silent</span>
                                </span>
                            </div>
                            <p t-if="panelError('ingest')" class="ic-mb-empty ic-mb-panel-error" t-esc="panelError('ingest')"/>
                            <div t-elif="timeline.length" class="ic-fb-timeline" role="group" aria-labelledby="ic-fb-ingest">
                                <t t-foreach="timeline" t-as="row" t-key="row.host_id">
                                    <div class="ic-fb-tl-row">
                                        <span class="ic-fb-tl-name" t-att-title="row.name">
                                            <a t-if="canOpenHost(row)" href="#" class="ic-hb-link"
                                               t-on-click.prevent="() => this.openHost(row)" t-esc="row.name"/>
                                            <t t-else="" t-esc="row.name"/>
                                        </span>
                                        <div class="ic-fb-tl-bar" role="img" t-att-aria-label="row.name">
                                            <t t-foreach="row.segments" t-as="seg" t-key="seg_index">
                                                <span t-att-class="'ic-fb-tl-seg is-' + seg.state"
                                                      t-att-style="segStyle(seg)" t-att-title="segTitle(seg)"/>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                                <p t-if="timelineHidden" class="ic-mb-empty" t-esc="timelineHiddenText"/>
                            </div>
                            <p t-else="" class="ic-mb-empty">No server reported in this window.</p>
                        </div>
                    </div>
                </section>
                <p class="ic-mb-meta" t-if="state.updatedAt" t-esc="metaText"/>
            </t>
        </div>
    </t>

</templates>
