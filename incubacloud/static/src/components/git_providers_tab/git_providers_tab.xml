<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="incubacloud.GitProvidersTab">
    <div class="ic-gitp">
        <t t-if="state.loading">
            <div class="ic-detail-loading">Loading…</div>
        </t>
        <t t-elif="state.loadError">
            <div class="rl-stub" role="alert">
                <span class="rl-si"><t t-out="env.icon('alert', 46)"/></span>
                <p t-esc="state.loadError"/>
                <button class="rl-btn rl-btn-primary" style="margin-top: 14px;"
                        t-on-click="() => this.load()">
                    Retry
                </button>
            </div>
        </t>
        <t t-else="">

            <div class="rl-saas-fsec">Git providers</div>
            <p class="rl-tabnote">
                GitLab servers the panel deploys and rebuilds from: gitlab.com or your
                own. Repositories on GitHub use the GitHub tab.
            </p>
            <p t-if="state.network === 'public'" class="rl-set-warning">
                <i class="fa fa-globe"/>
                This panel only accepts GitLab servers on a public address.
            </p>
            <div class="rl-set-hintbox">
                <i class="fa fa-key"/>
                To deploy, a deploy token or a project token with the read_repository
                scope, one per repository, is enough. Rebuild on push, merge request
                notes and the assistant's writes will need a group or personal token
                with the api scope and the Maintainer role, limited to your team's
                namespace. Deploy tokens do not answer on the API.
            </div>

            <!-- ── Providers ─────────────────────────────────────────── -->
            <t t-foreach="state.providers" t-as="provider" t-key="provider.id">
                <div class="rl-ghcard ic-gitp-card"
                     t-if="!(state.draft and state.draft.id === provider.id)">
                    <div class="rl-ghi"><t t-out="env.icon('git', 20)"/></div>
                    <div class="ic-gitp-body">
                        <div class="ic-gitp-head">
                            <h3 t-esc="provider.name"/>
                            <span class="ic-gitp-badge">GitLab · <t t-esc="provider.authority"/></span>
                        </div>
                        <div class="rl-set-status">
                            <span class="rl-set-status-k">Base URL</span>
                            <span class="rl-set-status-v" t-esc="provider.base_url"/>
                            <t t-if="provider.has_ca">
                                <span class="rl-set-status-k">CA (SHA-256)</span>
                                <span class="rl-set-status-v">
                                    <t t-foreach="provider.ca_fingerprints" t-as="fp" t-key="fp_index">
                                        <div t-esc="fp"/>
                                    </t>
                                </span>
                            </t>
                            <t t-if="provider.last_check_at">
                                <span class="rl-set-status-k">Last test</span>
                                <span class="rl-set-status-v">
                                    git: <t t-esc="provider.last_check_git"/>
                                    · API: <t t-esc="provider.last_check_api"/>
                                </span>
                            </t>
                        </div>

                        <t t-if="provider.credentials">
                            <div class="ic-gitp-creds">
                                <t t-if="!provider.credentials.length">
                                    <p class="rl-set-hint">
                                        No credentials: repositories of this server are read as public ones.
                                    </p>
                                </t>
                                <t t-foreach="provider.credentials" t-as="cred" t-key="cred.id">
                                    <div class="ic-gitp-cred">
                                        <span class="ic-gitp-ns" t-esc="cred.namespace || provider.authority"/>
                                        <span class="ic-gitp-kind" t-esc="kindLabel(cred.kind)"/>
                                        <span class="ic-gitp-scopes" t-esc="scopesLabel(cred)"/>
                                        <span t-if="cred.token_user" class="ic-gitp-meta">
                                            @<t t-esc="cred.token_user"/>
                                        </span>
                                        <span t-if="cred.expires_on" class="ic-gitp-meta"
                                              t-esc="expiresLabel(cred)"/>
                                    </div>
                                    <p t-if="!cred.has_token" class="rl-set-inline-msg rl-set-inline-msg--error">
                                        This credential has no token: enter it again.
                                    </p>
                                    <p t-elif="cred.scopes_unchecked" class="rl-set-hint ic-gitp-writes">
                                        The scopes of this token have not been read from GitLab, so it is taken as one that can write. Use Test connection to read them.
                                    </p>
                                    <p t-elif="cred.writes" class="rl-set-hint ic-gitp-writes">
                                        This token can write to repositories. When no token that only reads covers a repository, this one clones it and travels inside the image of instances from 11.0 to 19.0: add a deploy token, or a token with read_repository only.
                                    </p>
                                </t>
                            </div>
                        </t>

                        <t t-foreach="state.warnings[provider.id] || []" t-as="warning" t-key="warning_index">
                            <p class="rl-set-inline-msg rl-set-inline-msg--error" t-esc="warning"/>
                        </t>

                        <t t-if="state.canManage">
                            <div class="rl-frow ic-gitp-test">
                                <label t-att-for="'ic-gitp-test-' + provider.id">Repository URL to test</label>
                                <div class="rl-frow-inline">
                                    <input type="text" t-att-id="'ic-gitp-test-' + provider.id"
                                           t-att-placeholder="provider.base_url + '/group/repository'"
                                           t-att-value="state.testUrl[provider.id] || ''"
                                           t-on-input="(ev) => state.testUrl[provider.id] = ev.target.value"/>
                                    <button class="rl-btn rl-btn-ghost"
                                            t-att-disabled="state.testing === provider.id"
                                            t-on-click="() => this.testProvider(provider)">
                                        <i t-att-class="'fa ' + (state.testing === provider.id ? 'fa-spinner fa-spin' : 'fa-plug')"/>
                                        Test connection
                                    </button>
                                </div>
                            </div>
                            <t t-set="result" t-value="state.testResult[provider.id]"/>
                            <t t-if="result">
                                <p t-if="result.error" class="rl-set-inline-msg rl-set-inline-msg--error" t-esc="result.error"/>
                                <t t-if="result.git">
                                    <p t-att-class="'rl-set-inline-msg rl-set-inline-msg--' + (result.git.code === 'ok' ? 'success' : 'error')">
                                        <strong>git:</strong> <t t-esc="result.git.message"/>
                                    </p>
                                    <p t-att-class="'rl-set-inline-msg rl-set-inline-msg--' + (result.api.code === 'ok' ? 'success' : 'info')">
                                        <strong>API:</strong> <t t-esc="result.api.message"/>
                                    </p>
                                </t>
                            </t>
                            <p t-if="state.deleteError[provider.id]"
                               class="rl-set-inline-msg rl-set-inline-msg--error"
                               t-esc="state.deleteError[provider.id]"/>
                            <div class="rl-set-actions ic-gitp-actions">
                                <button class="rl-btn rl-btn-ghost" t-att-disabled="!!state.draft"
                                        t-on-click="() => this.editProvider(provider)">
                                    <i class="fa fa-pencil"/> Edit
                                </button>
                                <button class="rl-btn rl-btn-danger" t-att-disabled="!!state.draft"
                                        t-on-click="() => this.deleteProvider(provider)">
                                    <i class="fa fa-trash-o"/> Delete
                                </button>
                            </div>
                        </t>
                    </div>
                </div>
                <t t-else="">
                    <t t-call="incubacloud.GitProviderEditor"/>
                </t>
            </t>

            <t t-if="state.draft and !state.draft.id">
                <t t-call="incubacloud.GitProviderEditor"/>
            </t>

            <t t-if="!state.providers.length and !state.draft">
                <p class="rl-set-hint">No Git providers yet.</p>
            </t>

            <div t-if="state.canManage and !state.draft" class="rl-set-actions ic-gitp-add">
                <button class="rl-btn rl-btn-primary" t-on-click="addProvider">
                    <i class="fa fa-plus"/> Add a GitLab server
                </button>
            </div>

            <!-- ── Webhooks (G3) ─────────────────────────────────────── -->
            <t t-if="state.providers.length">
                <div class="rl-saas-fsec ic-gitp-hookhead">Webhooks</div>
                <p class="rl-tabnote">
                    A GitLab webhook tells the panel about each push, so the instances
                    that follow the branch rebuild. Register it from a GitLab repository
                    line of a project or an instance.
                </p>
                <p t-if="state.hooksError" class="rl-set-inline-msg rl-set-inline-msg--error"
                   t-esc="state.hooksError"/>
                <p t-if="state.hooksNotice" class="rl-set-inline-msg rl-set-inline-msg--error"
                   t-esc="state.hooksNotice"/>
                <p t-elif="!state.hooks.length" class="rl-set-hint">No webhooks yet.</p>
                <t t-foreach="state.hooks" t-as="hook" t-key="hook.id">
                    <div class="ic-gitp-hook">
                        <div class="ic-gitp-hookrow">
                            <span class="ic-gitp-ns" t-esc="hook.path"/>
                            <span t-if="hook.scope === 'group'" class="ic-gitp-kind">group</span>
                            <span t-att-class="'rl-pill ' + hookStatePill(hook.state)">
                                <span class="rl-d"/><t t-esc="hookStateLabel(hook.state)"/>
                            </span>
                            <span class="ic-gitp-meta" t-esc="hook.provider"/>
                            <span class="ic-gitp-meta">
                                <t t-if="hook.by_api">set up by the panel</t>
                                <t t-else="">set up by hand</t>
                            </span>
                            <span t-if="hook.last_delivery_at" class="ic-gitp-meta">
                                Last delivery: <t t-esc="dateLabel(hook.last_delivery_at)"/>
                            </span>
                        </div>
                        <p t-if="hook.state === 'failing'" class="rl-set-inline-msg rl-set-inline-msg--error">
                            GitLab disabled this webhook after failed deliveries: the pushes of that time were lost. Press Verify, then rebuild by hand the instances that need it.
                        </p>
                        <p t-elif="hook.state === 'orphan'" class="rl-set-hint">
                            No repository line uses this webhook. The panel deletes it 7 days after the last line went; one set up by hand must be deleted in GitLab too.
                        </p>
                        <p t-elif="!hook.by_api and hook.state === 'pending'" class="rl-set-hint">
                            In GitLab, open Settings → Webhooks → Add new webhook, paste the URL and the secret, tick Push events and Merge request events, keep Enable SSL verification, and save. Then press Test → Tag push events, never Push events, which would rebuild.
                        </p>

                        <div t-if="state.hookSecret[hook.id]" class="rl-set-status ic-gitp-secret">
                            <span class="rl-set-status-k">URL</span>
                            <span class="rl-set-status-v" t-esc="state.hookSecret[hook.id].url"/>
                            <span class="rl-set-status-k">Secret token</span>
                            <span class="rl-set-status-v" t-esc="state.hookSecret[hook.id].secret"/>
                        </div>

                        <t t-foreach="hook.failed_events" t-as="event" t-key="event.id">
                            <div class="ic-gitp-event">
                                <span class="ic-gitp-meta" t-esc="dateLabel(event.created_at)"/>
                                <span class="ic-gitp-kind" t-esc="event.event_type"/>
                                <span class="ic-gitp-error" t-esc="event.error"/>
                                <button class="rl-btn rl-btn-ghost rl-btn-sm"
                                        t-att-disabled="state.hookBusy === hook.id"
                                        t-on-click="() => this.reprocessEvent(hook, event)">
                                    <i class="fa fa-repeat"/> Reprocess
                                </button>
                            </div>
                        </t>

                        <t t-set="hookRes" t-value="state.hookResult[hook.id]"/>
                        <p t-if="hookRes and hookRes.error" class="rl-set-inline-msg rl-set-inline-msg--error" t-esc="hookRes.error"/>
                        <p t-if="hookRes and hookRes.success" class="rl-set-inline-msg rl-set-inline-msg--success" t-esc="hookRes.success"/>

                        <div class="rl-set-actions ic-gitp-hookactions">
                            <button t-if="hook.by_api" class="rl-btn rl-btn-ghost rl-btn-sm"
                                    t-att-disabled="state.verifying === hook.id"
                                    t-on-click="() => this.verifyHook(hook)">
                                <i t-att-class="'fa ' + (state.verifying === hook.id ? 'fa-spinner fa-spin' : 'fa-check-circle-o')"/>
                                <t t-if="state.verifying === hook.id">Waiting for the delivery…</t>
                                <t t-else="">Verify</t>
                            </button>
                            <t t-if="state.canManage">
                                <button t-if="!state.hookSecret[hook.id]" class="rl-btn rl-btn-ghost rl-btn-sm"
                                        t-att-disabled="state.hookBusy === hook.id"
                                        t-on-click="() => this.revealHookSecret(hook)">
                                    <i class="fa fa-eye"/> Show secret
                                </button>
                                <button t-else="" class="rl-btn rl-btn-ghost rl-btn-sm"
                                        t-on-click="() => this.hideHookSecret(hook)">
                                    <i class="fa fa-eye-slash"/> Hide secret
                                </button>
                                <button class="rl-btn rl-btn-ghost rl-btn-sm"
                                        t-att-disabled="state.hookBusy === hook.id"
                                        t-on-click="() => this.revealHookSecret(hook, true)">
                                    <i class="fa fa-refresh"/> Rotate secret
                                </button>
                                <button class="rl-btn rl-btn-danger rl-btn-sm"
                                        t-att-disabled="state.hookBusy === hook.id"
                                        t-on-click="() => this.deleteHook(hook)">
                                    <i class="fa fa-trash-o"/> Delete
                                </button>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>

        <IcConfirmDialog t-if="state.confirmDialog"
                         title="state.confirmDialog.title"
                         message="state.confirmDialog.message"
                         confirmLabel="state.confirmDialog.confirmLabel"
                         isDanger="state.confirmDialog.isDanger"
                         onConfirm="state.confirmDialog.onConfirm"
                         onCancel="state.confirmDialog.onCancel"/>
    </div>
</t>

<t t-name="incubacloud.GitProviderEditor">
    <div class="rl-set-manual ic-gitp-editor">
        <div class="rl-fgrid">
            <div class="rl-frow">
                <label for="ic-gitp-name">Name <span class="rl-req">*</span></label>
                <input id="ic-gitp-name" type="text" placeholder="GitLab of Acme"
                       t-att-value="state.draft.name"
                       t-on-input="(ev) => state.draft.name = ev.target.value"/>
            </div>
            <div class="rl-frow">
                <label for="ic-gitp-base">Base URL <span class="rl-req">*</span></label>
                <input id="ic-gitp-base" type="text" placeholder="https://gitlab.com"
                       t-att-value="state.draft.base_url"
                       t-on-input="(ev) => state.draft.base_url = ev.target.value"/>
                <span class="rl-th">https only; a port or a path prefix if the server has one.</span>
            </div>
            <div class="rl-frow rl-full">
                <label for="ic-gitp-ca">CA certificate (PEM)</label>
                <textarea id="ic-gitp-ca" rows="4" class="rl-set-pem"
                          placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----"
                          t-att-value="state.draft.ca_bundle"
                          t-on-input="(ev) => state.draft.ca_bundle = ev.target.value"/>
                <span class="rl-th">
                    Only for a server whose certificate a private CA signs. Public: it is not a secret.
                </span>
            </div>
        </div>

        <div class="rl-saas-fsec ic-gitp-credhead">Credentials</div>
        <p class="rl-tabnote">
            Each token covers a namespace: empty for the whole server, a group, a
            subgroup or a project path. A repository uses the token of the longest
            namespace that covers it.
        </p>
        <t t-foreach="state.draft.credentials" t-as="cred" t-key="cred_index">
            <div class="ic-gitp-credrow">
                <div class="rl-frow">
                    <label>Namespace</label>
                    <input type="text" placeholder="group/subgroup"
                           t-att-value="cred.namespace"
                           t-on-input="(ev) => cred.namespace = ev.target.value"/>
                </div>
                <div class="rl-frow">
                    <label>Type</label>
                    <RlSelect options="kindOptions" value="cred.kind"
                              onChange="(value) => cred.kind = value"
                              ariaLabel.translate="Token type"/>
                </div>
                <div class="rl-frow" t-if="cred.kind === 'deploy'">
                    <label>User name</label>
                    <input type="text" placeholder="gitlab+deploy-token-1"
                           t-att-value="cred.username"
                           t-on-input="(ev) => cred.username = ev.target.value"/>
                </div>
                <div class="rl-frow">
                    <label>Access token</label>
                    <input type="password" autocomplete="new-password"
                           t-att-placeholder="tokenPlaceholder(cred)"
                           t-att-value="cred.token"
                           t-on-input="(ev) => cred.token = ev.target.value"/>
                </div>
                <div class="rl-frow" t-if="cred.kind === 'deploy'">
                    <label>Expires on</label>
                    <input type="date" t-att-value="cred.expires_on"
                           t-on-input="(ev) => cred.expires_on = ev.target.value"/>
                </div>
                <button class="rl-repo-rm ic-gitp-credrm" title="Remove credential"
                        t-on-click="() => this.removeCredential(cred_index)">
                    <t t-out="env.icon('x', 13)"/>
                </button>
            </div>
        </t>
        <button class="rl-btn rl-btn-ghost rl-btn-sm" t-on-click="addCredential">
            <i class="fa fa-plus"/> Add credential
        </button>

        <p t-if="state.saveError" class="rl-set-inline-msg rl-set-inline-msg--error" t-esc="state.saveError"/>
        <div class="rl-set-actions ic-gitp-actions">
            <button class="rl-btn rl-btn-primary" t-att-disabled="state.saving" t-on-click="save">
                <i t-if="state.saving" class="fa fa-spinner fa-spin"/>
                Save
            </button>
            <button class="rl-btn rl-btn-ghost" t-att-disabled="state.saving" t-on-click="cancelEdit">
                Cancel
            </button>
        </div>
    </div>
</t>

</templates>
