<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="incubacloud.ImportProjectModal">
        <div class="ic-modal-overlay" t-on-click="onOverlayClick">
            <div class="ic-modal ic-modal--import"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="ic-import-project-title"
                 t-ref="box"
                 t-on-click.stop="">

                <!-- Header -->
                <header class="ic-modal__header">
                    <div class="ic-import-header">
                        <span class="ic-import-badge">
                            <t t-out="env.icon('git', 13)"/>
                            GitHub
                        </span>
                        <h3 id="ic-import-project-title">Import project from GitHub</h3>
                    </div>
                    <button t-if="state.step !== 'progress'"
                            class="ic-modal__close" aria-label="Close" t-on-click="close">
                        <t t-out="env.icon('x', 16)"/>
                    </button>
                </header>

                <!-- ── Step: Input (URL + Branch) ─────────────────────── -->
                <t t-if="state.step === 'input'">
                    <section class="ic-modal__body">
                        <p class="ic-import-hint">
                            Paste the GitHub URL of your project. We will automatically
                            detect the project type (doodba / odoo.sh / simple), import
                            all repositories, and create a production instance.
                        </p>

                        <div class="ic-frow">
                            <label>GitHub repository URL <span class="ic-req">*</span></label>
                            <div class="ic-import-url-row">
                                <input
                                    type="url"
                                    t-model="state.repoUrl"
                                    placeholder="https://github.com/your-org/your-project"
                                    t-on-keydown="onUrlKeydown"
                                    t-on-blur="onUrlBlur"
                                />
                                <span t-if="state.loadingBranches" class="ic-repo-spinner"
                                      title="Fetching branches…">
                                    <span class="ic-spin"/>
                                </span>
                            </div>
                            <div t-if="state.branchError" class="ic-repo-fetch-error"
                                 t-esc="state.branchError"/>
                        </div>

                        <div class="ic-frow">
                            <label>Branch</label>
                            <SearchSelect
                                options="state.branches"
                                value="state.branch"
                                onChange="(v) => { state.branch = v; }"
                                placeholder="'main'"
                                loading="state.loadingBranches"
                                allowFreeText="true"
                                emptyLabel.translate="— select branch —"
                            />
                        </div>
                    </section>

                    <footer class="ic-modal__footer">
                        <button class="ic-btn ic-btn--ghost" t-on-click="close">
                            Cancel
                        </button>
                        <button
                            class="ic-btn ic-btn--primary"
                            t-on-click="doImport"
                            t-att-disabled="!isUrlValid">
                            <t t-out="env.icon('download', 15)"/>
                            Import
                        </button>
                    </footer>
                </t>

                <!-- ── Step: Progress ─────────────────────────────────── -->
                <t t-if="state.step === 'progress'">
                    <section class="ic-modal__body">
                        <div class="ic-import-steps">
                            <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                                <div class="ic-jstep done">
                                    <span class="ic-jstep__icon"><t t-out="env.icon('check', 15)"/></span>
                                    <span t-esc="msg.text"/>
                                </div>
                            </t>
                            <div class="ic-jstep run">
                                <span class="ic-jstep__icon"><span class="ic-spin"/></span>
                                <span>Importing project…</span>
                            </div>
                        </div>
                    </section>
                    <footer class="ic-modal__footer"/>
                </t>

                <!-- ── Step: Done ─────────────────────────────────────── -->
                <t t-if="state.step === 'done'">
                    <section class="ic-modal__body">
                        <div class="ic-import-steps">
                            <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                                <div class="ic-jstep done">
                                    <span class="ic-jstep__icon"><t t-out="env.icon('check', 15)"/></span>
                                    <span t-esc="msg.text"/>
                                </div>
                            </t>
                        </div>
                        <t t-if="state.result?.sha_warning">
                            <div class="ic-alert ic-alert--warning mt-3" role="alert">
                                <span class="ic-alert__icon"><t t-out="env.icon('alert', 15)"/></span>
                                <span t-esc="state.result.sha_warning"/>
                            </div>
                        </t>
                    </section>
                    <footer class="ic-modal__footer">
                        <button class="ic-btn ic-btn--primary" t-on-click="goToInstance">
                            <t t-out="env.icon('fwd', 15)"/>
                            Go to instance
                        </button>
                    </footer>
                </t>

                <!-- ── Step: Error ────────────────────────────────────── -->
                <t t-if="state.step === 'error'">
                    <section class="ic-modal__body">
                        <div class="ic-import-steps">
                            <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                                <div class="ic-jstep done">
                                    <span class="ic-jstep__icon"><t t-out="env.icon('check', 15)"/></span>
                                    <span t-esc="msg.text"/>
                                </div>
                            </t>
                        </div>
                        <div class="ic-alert ic-alert--error" role="alert">
                            <span class="ic-alert__icon"><t t-out="env.icon('alert', 15)"/></span>
                            <span class="ic-alert__text"><t t-esc="state.error"/></span>
                        </div>
                    </section>
                    <footer class="ic-modal__footer ic-modal__footer--between">
                        <button class="ic-btn ic-btn--ghost" t-on-click="retry">
                            <t t-out="env.icon('back', 15)"/>
                            Try again
                        </button>
                        <button class="ic-btn ic-btn--ghost" t-on-click="close">
                            Close
                        </button>
                    </footer>
                </t>

            </div>
        </div>
    </t>

</templates>
