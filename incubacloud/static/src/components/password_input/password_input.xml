<templates>

    <t t-name="incubacloud.PasswordInput">
        <div class="ic-password-input">

            <!-- A stored value: never shown back; «Stored» until replaced -->
            <div t-if="showsStored" class="ic-password-stored">
                <t t-out="env.icon('lock', 14)"/>
                <span class="ic-password-stored__state">Stored</span>
                <button type="button" class="rl-btn rl-btn-ghost rl-btn-sm"
                        t-ref="replace"
                        t-att-id="replaceId"
                        aria-label="Replace"
                        t-att-aria-describedby="labelId"
                        t-on-click="() => this.replace()">Replace</button>
            </div>

            <div t-else="" class="ic-password-input-row">
                <input
                    t-ref="input"
                    t-att-id="props.id"
                    t-att-type="state.visible ? 'text' : 'password'"
                    class="ic-password-field"
                    t-att-placeholder="placeholder"
                    t-att-value="value"
                    t-att-aria-invalid="props.ariaInvalid ? 'true' : undefined"
                    t-att-aria-describedby="inputDescribedby"
                    t-on-input="onInput"
                    autocomplete="new-password"/>

                <!-- Toggle show/hide — only useful when the user has typed something -->
                <t t-if="value">
                    <button class="ic-password-btn"
                            type="button"
                            t-att-title="state.visible ? 'Hide' : 'Show'"
                            t-on-click="toggleVisible">
                        <i t-att-class="state.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                    </button>
                </t>

                <!-- Copy to clipboard — only when the user has typed a new value -->
                <t t-if="value">
                    <button class="ic-password-btn ic-password-btn-copy"
                            type="button"
                            t-att-title="state.copied ? 'Copied!' : 'Copy to clipboard'"
                            t-on-click="copyToClipboard">
                        <i t-att-class="state.copied ? 'fa fa-check' : 'fa fa-clipboard'"/>
                    </button>
                </t>

                <button t-if="props.hasValue" type="button" class="rl-btn rl-btn-ghost rl-btn-sm"
                        t-on-click="() => this.keep()">Keep stored</button>
            </div>

            <span t-if="hint" class="ic-password-hint" t-att-id="hintId" t-esc="hint"/>

        </div>
    </t>

</templates>
