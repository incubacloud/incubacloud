<templates>

    <t t-name="incubacloud.PasswordInput">
        <div class="ic-password-input">

            <div class="ic-password-input-row">
                <input
                    t-att-type="state.visible ? 'text' : 'password'"
                    t-att-class="'ic-password-field' + (isSet ? ' ic-password-field--set' : '')"
                    placeholder="••••••••••••••••••••"
                    t-att-value="state.inputValue"
                    t-on-input="onInput"
                    autocomplete="new-password"/>

                <!-- "Value set" badge — shown when server has a value and user hasn't typed yet -->
                <t t-if="isSet">
                    <span class="ic-password-set-badge" t-att-title="hint">
                        <i class="fa fa-check-circle"/>
                    </span>
                </t>

                <!-- Toggle show/hide — only useful when the user has typed something -->
                <t t-if="state.inputValue">
                    <button class="ic-password-btn"
                            type="button"
                            t-att-title="state.visible ? 'Hide' : 'Show'"
                            t-on-click="toggleVisible">
                        <i t-att-class="state.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                    </button>
                </t>

                <!-- Copy to clipboard — only when the user has typed a new value -->
                <t t-if="state.inputValue">
                    <button class="ic-password-btn ic-password-btn-copy"
                            type="button"
                            t-att-title="state.copied ? 'Copied!' : 'Copy to clipboard'"
                            t-on-click="copyToClipboard">
                        <i t-att-class="state.copied ? 'fa fa-check' : 'fa fa-clipboard'"/>
                    </button>
                </t>
            </div>

            <span class="ic-password-hint" t-esc="hint"/>

        </div>
    </t>

</templates>
