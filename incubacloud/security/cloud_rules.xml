            ]"/>
        </record>

        <record id="rule_instance_backup_all" model="ir.rule">
            <field name="name">Instance Backup: all (PM+)</field>
            <field name="model_id" ref="model_cloud_instance_backup"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_project_manager')),
