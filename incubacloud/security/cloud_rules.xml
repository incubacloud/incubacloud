<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Record rules for project-scoped visibility.

            Stakeholder + Consultant: can only see records linked to projects
            where they are members (cloud.project.member_ids).

            Project Manager and above: see everything (rule domain = True).

            Since Odoo OR-s record rules across groups, a PM (who also has
            Consultant via implied_ids) matches the PM rule and sees all.
        -->

        <!-- ── cloud.project ──────────────────────────────────────── -->

        <record id="rule_project_member" model="ir.rule">
            <field name="name">Project: members only</field>
            <field name="model_id" ref="model_cloud_project"/>
            <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_user')),
                (4, ref('group_cloud_consultant')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_project_all" model="ir.rule">
            <field name="name">Project: all (PM+)</field>
            <field name="model_id" ref="model_cloud_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_project_manager')),
            ]"/>
        </record>

        <!-- ── cloud.instance ─────────────────────────────────────── -->

        <record id="rule_instance_member" model="ir.rule">
            <field name="name">Instance: project members only</field>
            <field name="model_id" ref="model_cloud_instance"/>
            <field name="domain_force">[('project_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_user')),
                (4, ref('group_cloud_consultant')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_instance_all" model="ir.rule">
            <field name="name">Instance: all (PM+)</field>
            <field name="model_id" ref="model_cloud_instance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_project_manager')),
            ]"/>
        </record>

        <!-- ── cloud.job ──────────────────────────────────────────── -->

        <record id="rule_job_member" model="ir.rule">
            <field name="name">Job: project members only</field>
            <field name="model_id" ref="model_cloud_job"/>
            <field name="domain_force">['|',
                ('instance_id', '=', False),
                ('instance_id.project_id.member_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_user')),
                (4, ref('group_cloud_consultant')),
            ]"/>
        </record>

        <record id="rule_job_all" model="ir.rule">
            <field name="name">Job: all (PM+)</field>
            <field name="model_id" ref="model_cloud_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_project_manager')),
            ]"/>
        </record>

        <!-- ── cloud.alert ────────────────────────────────────────── -->

        <record id="rule_alert_member" model="ir.rule">
            <field name="name">Alert: project members only</field>
            <field name="model_id" ref="model_cloud_alert"/>
            <field name="domain_force">['|', '|',
                ('project_id.member_ids', 'in', [user.id]),
                ('instance_id.project_id.member_ids', 'in', [user.id]),
                '&amp;', ('project_id', '=', False), ('instance_id', '=', False)
            ]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_user')),
                (4, ref('group_cloud_consultant')),
            ]"/>
        </record>

        <record id="rule_alert_all" model="ir.rule">
            <field name="name">Alert: all (PM+)</field>
            <field name="model_id" ref="model_cloud_alert"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_cloud_project_manager')),
            ]"/>
        </record>

