msgstr "Host SMTP de una instancia"

#. module: incubacloud
#. odoo-javascript
#: code:addons/incubacloud/static/src/components/settings/core_sections.js:0
msgid ""
"SSH, sudo, auditd and fail2ban, kept 90 days in the central. Applies on the "
"next agent install."
msgstr ""
"SSH, sudo, auditd y fail2ban, conservados 90 días en el central. Se aplica "
"en la siguiente instalación de los agentes."

#. module: incubacloud
#. odoo-javascript
#: code:addons/incubacloud/static/src/components/settings/core_settings_block.xml:0
