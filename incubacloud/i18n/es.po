#: code:addons/incubacloud/static/src/components/instance_detail/instance_detail.xml:0
msgid ""
"No backup backend configured. Assign one in this instance's Networking tab,\n"
"                        in the project settings, or set a global default in Settings › General."
msgstr ""
"No hay backend de respaldo configurado. Asigne uno en la pestaña Redes de "
"esta instancia, en la configuración del proyecto, o defina uno global por "
"defecto en Configuración › General."

#. module: incubacloud
#. odoo-javascript
#: code:addons/incubacloud/static/src/components/settings/core_sections.js:0
msgid "No panel action and no login inside it for this long. 0 turns it off."
msgstr ""
"Sin acciones desde el panel ni inicios de sesión dentro durante este tiempo."
" 0 lo desactiva."

#. module: incubacloud
#. odoo-javascript
#: code:addons/incubacloud/static/src/components/settings/core_settings_block.xml:0
