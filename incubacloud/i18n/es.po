#: code:addons/incubacloud/static/src/components/core_rates_tab/core_rates_tab.xml:0
msgid ""
"Protects the GitHub webhook, the terminal, connect as user, the logs and "
"GitHub imports against CPU exhaustion. Past a limit the panel refuses until "
"the window ends. A value of 0 or less falls back to the documented default."
msgstr ""
"Protege el webhook de GitHub, el terminal, conectar como usuario, los logs y"
" las importaciones de GitHub contra el agotamiento de la CPU. Pasado un "
"límite, el panel rechaza hasta que acaba la ventana. Un valor de 0 o menos "
"vuelve al valor por defecto documentado."

#. module: incubacloud
#. odoo-javascript
#: code:addons/incubacloud/static/src/components/settings/core_settings_block.xml:0
msgid "Purging…"
msgstr "Purgando…"

#. module: incubacloud
#. odoo-javascript
