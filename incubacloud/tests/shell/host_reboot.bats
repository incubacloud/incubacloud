#!/usr/bin/env bats
# Tests for scripts/host_reboot.sh.
#
# Every system path is pointed at the test's directory (IC_RUN_DIR,
# IC_BOOT_ID_FILE, IC_UNATTENDED_FILE, IC_GUARD_DIR, IC_DETACHED_GLOB);
# ``pgrep``, ``sudo`` and ``shutdown`` are stubs that log their calls.
#
# Run locally with:  bats incubacloud/tests/shell

setup() {
    SCRIPT="${BATS_TEST_DIRNAME}/../../scripts/host_reboot.sh"
    TMP="$(mktemp -d)"
    STUB_DIR="${TMP}/bin"
    mkdir -p "${STUB_DIR}" "${TMP}/run/systemd/shutdown" "${TMP}/guard.d"
    PATH="${STUB_DIR}:${PATH}"
    export PATH TMP
    export IC_RUN_DIR="${TMP}/run"
    export IC_BOOT_ID_FILE="${TMP}/boot_id"
    export IC_UNATTENDED_FILE="${TMP}/52incubacloud-unattended"
    export IC_GUARD_DIR="${TMP}/guard.d"
    export IC_DETACHED_GLOB="${TMP}/.incubacloud-detached-*"
    echo "082e0387-f50e-4ec6-86cd-dc52901eb9eb" > "${IC_BOOT_ID_FILE}"
    # pgrep finds what ${TMP}/running lists, one pattern per line.
    : > "${TMP}/running"
    cat > "${STUB_DIR}/pgrep" <<'EOF'
#!/usr/bin/env bash
echo "pgrep $*" >> "${TMP}/calls"
pattern="${!#}"
grep -qxF -- "$pattern" "${TMP}/running"
EOF
    cat > "${STUB_DIR}/sudo" <<'EOF'
#!/usr/bin/env bash
echo "sudo $*" >> "${TMP}/calls"
[ "$1" = "-n" ] && shift
exec "$@"
EOF
    cat > "${STUB_DIR}/shutdown" <<'EOF'
#!/usr/bin/env bash
echo "shutdown $*" >> "${TMP}/calls"
[ -z "${SHUTDOWN_FAILS:-}" ] || exit 1
[ -n "${SHUTDOWN_SCHEDULES_NOTHING:-}" ] || : > "${IC_RUN_DIR}/systemd/shutdown/scheduled"
EOF
    chmod +x "${STUB_DIR}/pgrep" "${STUB_DIR}/sudo" "${STUB_DIR}/shutdown"
}

teardown() {
    rm -rf "${TMP}"
}

_policy() {
    cat > "${IC_UNATTENDED_FILE}" <<EOF
// Auto-generated by IncubaCloud host hardening.
Unattended-Upgrade::Automatic-Reboot "$1";
Unattended-Upgrade::Automatic-Reboot-Time "04:00";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
EOF
}

@test "check: nothing pending" {
    _policy false
    run bash "$SCRIPT" check
    [ "$status" -eq 0 ]
    [[ "$output" == *"IC_BOOT_ID=082e0387-f50e-4ec6-86cd-dc52901eb9eb"* ]]
    [[ "$output" == *"IC_REBOOT_REQUIRED=0"* ]]
    [[ "$output" == *"IC_POLICY=kept"* ]]
}

@test "check: a restart pending names its packages once each" {
    : > "${IC_RUN_DIR}/reboot-required"
    printf 'linux-image-6.8\nlibc6\nlinux-image-6.8\n' > "${IC_RUN_DIR}/reboot-required.pkgs"
    run bash "$SCRIPT" check
    [ "$status" -eq 0 ]
    [[ "$output" == *"IC_REBOOT_REQUIRED=1"* ]]
    [[ "$output" == *"IC_REBOOT_PKGS=libc6 linux-image-6.8"* ]]
    [[ "$output" == *"IC_POLICY=none"* ]]
}

@test "check: the server's own restart is turned off" {
    _policy true
    run bash "$SCRIPT" check
    [ "$status" -eq 0 ]
    [[ "$output" == *"IC_POLICY=fixed"* ]]
    grep -q 'Automatic-Reboot "false"' "${IC_UNATTENDED_FILE}"
    ! grep -q 'Automatic-Reboot-Time' "${IC_UNATTENDED_FILE}"
    grep -q 'Remove-Unused-Kernel-Packages "true"' "${IC_UNATTENDED_FILE}"
}

@test "guard: a free server says yes" {
    run bash "$SCRIPT" guard
    [ "$status" -eq 0 ]
    [[ "$output" == *"IC_VETO="* ]]
}

@test "guard: a copy running says no" {
    echo "pg_dump" > "${TMP}/running"
    run bash "$SCRIPT" guard
    [ "$status" -eq 75 ]
    [[ "$output" == *"IC_VETO=pg_dump is running"* ]]
}

@test "guard: an image build says no" {
    echo "docker-buildx" > "${TMP}/running"
    run bash "$SCRIPT" guard
    [ "$status" -eq 75 ]
    [[ "$output" == *"image build"* ]]
}

@test "guard: a step run apart that is alive says no, one that ended does not" {
    dir="${TMP}/.incubacloud-detached-0123abcd"
    mkdir "$dir"
    sleep 30 &
    pid=$!
    start="$(awk '{print $22}' "/proc/${pid}/stat")"
    echo "${pid} ${pid} ${start}" > "${dir}/pid"
    run bash "$SCRIPT" guard
    kill "$pid"
    [ "$status" -eq 75 ]
    [[ "$output" == *"runs apart"* ]]
    echo 0 > "${dir}/exit"
    run bash "$SCRIPT" guard
    [ "$status" -eq 0 ]
}

@test "guard: an executable of the owner's that says no" {
    printf '#!/bin/sh\nexit 1\n' > "${IC_GUARD_DIR}/10-busy"
    chmod +x "${IC_GUARD_DIR}/10-busy"
    printf '#!/bin/sh\nexit 1\n' > "${IC_GUARD_DIR}/20-not-executable"
    run bash "$SCRIPT" guard
    [ "$status" -eq 75 ]
    [[ "$output" == *"10-busy"* ]]
    rm "${IC_GUARD_DIR}/10-busy"
    run bash "$SCRIPT" guard
    [ "$status" -eq 0 ]
}

@test "reboot: schedules the restart in a minute and checks it" {
    run bash "$SCRIPT" reboot
    [ "$status" -eq 0 ]
    [[ "$output" == *"IC_SCHEDULED=1"* ]]
    grep -q "shutdown -r +1" "${TMP}/calls"
}

@test "reboot: a restart that was not scheduled fails" {
    export SHUTDOWN_SCHEDULES_NOTHING=1
    run bash "$SCRIPT" reboot
    [ "$status" -ne 0 ]
    [[ "$output" == *"no restart is scheduled"* ]]
}

@test "reboot: shutdown failing fails" {
    export SHUTDOWN_FAILS=1
    run bash "$SCRIPT" reboot
    [ "$status" -ne 0 ]
}

@test "an unknown order fails" {
    run bash "$SCRIPT" nope
    [ "$status" -ne 0 ]
}
