<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Global (no group): a manager reads only their own too (D9). -->
        <record id="rule_assistant_conversation_owner" model="ir.rule">
            <field name="name">Assistant conversations: their owner only</field>
            <field name="model_id" ref="model_incubacloud_assistant_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_assistant_message_owner" model="ir.rule">
            <field name="name">Assistant messages: their conversation's owner only</field>
            <field name="model_id" ref="model_incubacloud_assistant_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
